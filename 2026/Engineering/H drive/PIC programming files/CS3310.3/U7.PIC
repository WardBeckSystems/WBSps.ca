; ----------   PIC16C5X HEADER   ----------

W       EQU     0

; RESET ADDRESSES

PIC54   EQU     $1FF
PIC55   EQU     $1FF
PIC56   EQU     $3FF
PIC57   EQU     $7FF

; STATUS WORD REGISTER f3

C       EQU     0
DC      EQU     1
Z       EQU     2
PD      EQU     3
TO      EQU     4
PA0     EQU     5
PA1     EQU     6
PA2     EQU     7

; OPERATIONAL REGISTER FILES

IND     EQU     00
RTCC    EQU     01
PC      EQU     02
STATUS  EQU     03
FSR     EQU     04
PORTA   EQU     05
PORTB   EQU     06
PORTC   EQU     07

; ----------   END HEADER   ----------

TXSR    EQU     08              ; TX SHIFT REGISTER
I       EQU     09              ; INDEX

KS1     EQU     10              ; SHAFT ENCODER DBOUNCE STATE
KS2     EQU     11

STATE2  EQU     12              ; SHAFT ENCODER ROTATION STATE

TEMP    EQU     13
NUM     EQU     14
LEVEL   EQU     15

D0      EQU     16              ; LCD DIGITS
D1      EQU     17
D2      EQU     18
D3      EQU     19

DEL     EQU     20
CNT     EQU     21
MKON    EQU     22
MKOFF   EQU     23

TXF     EQU     24

; ----------   PORTA BITS   ----------

DATA1   EQU     0               ; DISPLAY
CLK1    EQU     1
LOAD1   EQU     2
EXTRA   EQU     3               ; UNUSED

; ----------   PORTB BITS   ----------

ROW1    EQU     0
ROW2    EQU     1
ROW3    EQU     2
ROW4    EQU     3

COL1    EQU     4
COL2    EQU     5
COL3    EQU     6
COL4    EQU     7               ; UNUSED

; ----------   PORTC BITS   ----------

K1      EQU     0               ; SHAFT ENCODER
K2      EQU     1

CDATA1   EQU     2               ; CS3310
CCLK1    EQU     3
CLOAD1   EQU     5
CMUTE    EQU     6

DATA2   EQU     2               ; LCD
CLK2    EQU     3
LOAD2   EQU     4


; ----------   EQUATES   ----------

                                ; USE 4.00 MHz CRYSTAL AND TWO 15pF CAPS
                                ; OS2 = 1 MHz
DELAY   EQU     100             ; 1.25 msec with OPTION $02 ( RTCC=OS2/8 )
; DELAY   EQU     100             ; 5 msec with OPTION $04 ( RTCC=OS2/32 )

; ----------   JUMP TABLE   ----------

        ORG     $000
TXDIS   GOTO    RTXDIS
SCAN    GOTO    RSCAN
TXB1    GOTO    RTXB1

; ----------   NEXT STATE TABLE1   ----------
                        ; SET BIT 0 OF THE STATE TO INPUT
                        ; BEFORE CALLING NEXT1
KEYBIT  EQU     3       ; BIT TEST KEYBIT AFTER CALLING NEXT1
KCH     EQU     4

NEXT1   ANDLW   $0F     ; DEBOUNCE INPUT STATE MACHINE
        ADDWF   PC

        RETLW   0       ; KEYBIT CLEAR WHILE INPUT=0
        RETLW   2
        RETLW   0
        RETLW   4
        RETLW   0
        RETLW   6
        RETLW   0
        RETLW   8+16    ; 4TH INPUT=1 SO SET KEYBIT

        RETLW   10
        RETLW   8       ; KEYBIT SET WHILE INPUT=1
        RETLW   12
        RETLW   8
        RETLW   14
        RETLW   8
        RETLW   0+16    ; 4TH INPUT=0 SO CLEAR KEYBIT
        RETLW   8

; ----------   DIGITS LOOKUP TABLE3   ----------

DIGITS  ANDLW   $0F
        ADDWF   PC

        RETLW   $3F             ; 0
        RETLW   $06             ; 1
        RETLW   $5B             ; 2
        RETLW   $4F             ; 3

        RETLW   $66             ; 4
        RETLW   $6D             ; 5
        RETLW   $7D             ; 6
        RETLW   $07             ; 7

        RETLW   $7F             ; 8
        RETLW   $6F             ; 9
        RETLW   $77             ; A
        RETLW   $7C             ; B

        RETLW   $39             ; C
        RETLW   $5E             ; D
        RETLW   $79             ; E
        RETLW   $71             ; F

; ----------   NEXT STATE TABLE2   ----------

TINC    EQU     7
TDEC    EQU     6
TCH     EQU     5

NEXT2   ANDLW   $1F
        ADDWF   PC
; DOWN
        RETLW   $00+$00
        RETLW   $04+$40         ; DEC
        RETLW   $18+$A0         ; INC  CHANGE
        RETLW   $0C+$00

        RETLW   $10+$A0         ; INC  CHANGE
        RETLW   $04+$00
        RETLW   $08+$00
        RETLW   $0C+$40         ; DEC

        RETLW   $00+$40         ; DEC
        RETLW   $04+$00
        RETLW   $08+$00
        RETLW   $1C+$A0         ; INC  CHANGE

        RETLW   $00+$00
        RETLW   $14+$A0         ; INC  CHANGE
        RETLW   $08+$40         ; DEC
        RETLW   $0C+$00
; UP
        RETLW   $10+$00
        RETLW   $04+$60         ; DEC  CHANGE
        RETLW   $18+$80         ; INC
        RETLW   $1C+$00

        RETLW   $10+$80         ; INC
        RETLW   $14+$00
        RETLW   $18+$00
        RETLW   $0C+$60         ; DEC  CHANGE

        RETLW   $00+$60         ; DEC  CHANGE
        RETLW   $14+$00
        RETLW   $18+$00
        RETLW   $1C+$80         ; INC

        RETLW   $10+$00
        RETLW   $14+$80         ; INC
        RETLW   $08+$60         ; DEC  CHANGE
        RETLW   $1C+$00

; ----------   TRANSLATION TABLE4   ----------

TRANS4  ANDLW   $7F
        ADDWF   PC
        RETLW   $00
        RETLW   $01
        RETLW   $02
        RETLW   $03
        RETLW   $04
        RETLW   $05
        RETLW   $06
        RETLW   $07

        RETLW   $08
        RETLW   $09
        RETLW   $10
        RETLW   $11
        RETLW   $12
        RETLW   $13
        RETLW   $14
        RETLW   $15

        RETLW   $16
        RETLW   $17
        RETLW   $18
        RETLW   $19
        RETLW   $20
        RETLW   $21
        RETLW   $22
        RETLW   $23

        RETLW   $24
        RETLW   $25
        RETLW   $26
        RETLW   $27
        RETLW   $28
        RETLW   $29
        RETLW   $30
        RETLW   $31

        RETLW   $32
        RETLW   $33
        RETLW   $34
        RETLW   $35
        RETLW   $36
        RETLW   $37
        RETLW   $38
        RETLW   $39

        RETLW   $40
        RETLW   $41
        RETLW   $42
        RETLW   $43
        RETLW   $44
        RETLW   $45
        RETLW   $46
        RETLW   $47

        RETLW   $48
        RETLW   $49
        RETLW   $50
        RETLW   $51
        RETLW   $52
        RETLW   $53
        RETLW   $54
        RETLW   $55

        RETLW   $56
        RETLW   $57
        RETLW   $58
        RETLW   $59
        RETLW   $60
        RETLW   $61
        RETLW   $62
        RETLW   $63

        RETLW   $64
        RETLW   $65
        RETLW   $66
        RETLW   $67
        RETLW   $68
        RETLW   $69
        RETLW   $70
        RETLW   $71

        RETLW   $72
        RETLW   $73
        RETLW   $74
        RETLW   $75
        RETLW   $76
        RETLW   $77
        RETLW   $78
        RETLW   $79

        RETLW   $80
        RETLW   $81
        RETLW   $82
        RETLW   $83
        RETLW   $84
        RETLW   $85
        RETLW   $86
        RETLW   $87

        RETLW   $88
        RETLW   $89
        RETLW   $90
        RETLW   $91
        RETLW   $92
        RETLW   $93
        RETLW   $94
        RETLW   $95

        RETLW   $FF

; ----------   CODE   ----------

; ----------   INITIALIZATION CODE   ----------

        ORG     $100
INIT    XORLW   $FF             ; UNPROGRAMED NOP

        CLRF    PORTA           ; INITIALIZE PORTA
        MOVLW   $08
        TRIS    PORTA

        MOVLW   $FE             ; INITIALIZE PORTB
        MOVWF   PORTB
        MOVLW   $F0
        TRIS    PORTB

        CLRF    PORTC           ; INITIALIZE PORTC
        MOVLW   $03
        TRIS    PORTC
        BSF     PORTC,CLOAD1

        MOVLW   16
        MOVWF   I
        BCF     PORTA,DATA1
        BSF     PORTA,LOAD1

CLEAR   BSF     PORTA,CLK1
        NOP
        BCF     PORTA,CLK1
        DECFSZ  I
        GOTO    CLEAR

        MOVLW   $02             ; RTCC = OSC2 / 8
        OPTION

        MOVLW   DELAY           ; RESET COUNTER
        MOVWF   RTCC

        CLRF    KS1
        CLRF    KS2
        CLRF    STATE2
        CLRF    D3
        CLRF    D2
        CLRF    D1
        CLRF    D0
        CLRF    LEVEL
        CLRF    MKON
        CLRF    MKOFF
        MOVLW   1
        MOVWF   TXF
        MOVLW   4
        MOVWF   CNT
        MOVLW   10
        MOVWF   DEL

; ----------   MAIN CODE   ----------

MAIN    CALL    SCAN
        BTFSC   TXF,0
        GOTO    DISPLAY
        CALL    SCAN
        BTFSC   TXF,0
        GOTO    DISPLAY
        CALL    SCAN
        BTFSC   TXF,0
        GOTO    DISPLAY
        CALL    SCAN
        BTFSC   TXF,0
        GOTO    DISPLAY

        BTFSS   PORTB,COL1
        INCF    MKON
        MOVF    MKON,W
        CALL    NEXT1
        MOVWF   MKON

        BTFSS   PORTB,COL2
        INCF    MKOFF
        MOVF    MKOFF,W
        CALL    NEXT1
        MOVWF   MKOFF

        BTFSC   MKON,KEYBIT
        BCF     PORTC,CMUTE
        BTFSC   MKOFF,KEYBIT
        BSF     PORTC,CMUTE
        GOTO    MAIN

DISPLAY MOVLW   192
        SUBWF   LEVEL,W
        MOVWF   TEMP
        BTFSS   STATUS,C
        GOTO    MINUS           ; LEVEL < 192
                                ; LEVEL >= 192
PLUS    MOVLW   $26
        MOVWF   D3
        GOTO    OPNUM

MINUS   MOVLW   $24
        MOVWF   D3
        COMF    TEMP
        INCF    TEMP

OPNUM   RRF     TEMP,W
        CALL    TRANS4
        MOVWF   NUM
        SWAPF   NUM,W
        CALL    DIGITS
        MOVWF   D2
        MOVF    NUM,W
        CALL    DIGITS
        MOVWF   D1

        MOVLW   0
        BTFSC   TEMP,0
        MOVLW   5
        CALL    DIGITS
        MOVWF   D0

        BCF     TXF,0

        MOVF    LEVEL,W
        CALL    TXB1
        MOVF    LEVEL,W
        CALL    TXB1
        BSF     PORTC,CLOAD1

        CALL    SCAN
        MOVF    D3,W
        CALL    TXDIS
        CALL    SCAN
        MOVF    D2,W
        CALL    TXDIS
        CALL    SCAN
        MOVF    D1,W
        CALL    TXDIS
        CALL    SCAN
        MOVF    D0,W
        CALL    TXDIS

        BSF     PORTC,LOAD2
        NOP
        BCF     PORTC,LOAD2

        GOTO    MAIN


; ----------   SCAN SUBROUTINE  ----------

RSCAN
W1      MOVF    RTCC,W
        BTFSS   STATUS,Z
        GOTO    W1              ; WAIT FOR TIME OUT

        MOVLW   DELAY
        MOVWF   RTCC            ; RESET COUNTER

        DECFSZ  CNT
        GOTO    DONT

DO      MOVLW   4               ; ON 4TH CNT RESET TO 4 AND DEC DEL
        MOVWF   CNT
        DECF    DEL
        BTFSC   STATUS,Z
        INCF    DEL             ; MIN DEL IS 1
DONT
        BTFSC   PORTC,0
        INCF    KS1
        MOVF    KS1,W
        CALL    NEXT1
        MOVWF   KS1

        BTFSC   PORTC,1
        INCF    KS2
        MOVF    KS2,W
        CALL    NEXT1
        MOVWF   KS2

        BTFSC   KS1,KEYBIT
        BSF     STATE2,0
        BTFSC   KS2,KEYBIT
        BSF     STATE2,1
        MOVF    STATE2,W
        CALL    NEXT2
        MOVWF   STATE2

INC_L   BTFSS   STATE2,TINC
        GOTO    DEC_L

        BSF     PORTA,DATA1
        BSF     PORTA,CLK1
        NOP
        BCF     PORTA,CLK1

        BSF     TXF,0

        MOVF    DEL,W
        ADDWF   LEVEL,W
        BTFSC   STATUS,C
        MOVLW   255
        MOVWF   LEVEL

        MOVLW   4
        MOVWF   CNT
        MOVLW   10
        MOVWF   DEL
        RETLW   0

DEC_L   BTFSS   STATE2,TDEC
        RETLW   0

        BCF     PORTA,DATA1
        BSF     PORTA,CLK1
        NOP
        BCF     PORTA,CLK1

        BSF     TXF,0

        MOVF    DEL,W
        SUBWF   LEVEL,W
        BTFSS   STATUS,C
        MOVLW   0
        MOVWF   LEVEL

        MOVLW   4
        MOVWF   CNT
        MOVLW   10
        MOVWF   DEL
        RETLW   0

; ----------   TX SUBROUTINE   ----------

RTXDIS   MOVWF   TXSR
        BCF     PORTC,LOAD2
        MOVLW   8
        MOVWF   I

SHIFT2  BTFSC   TXSR,7
        BSF     PORTC,DATA2
        BTFSS   TXSR,7
        BCF     PORTC,DATA2

        BSF     PORTC,CLK2
        RLF     TXSR            ; DO SOMETHING
        BCF     PORTC,CLK2

        DECFSZ  I
        GOTO    SHIFT2
        RETLW   0

; ----------   TXB1 SUBROUTINE   ----------

RTXB1    MOVWF   TXSR
        BCF     PORTC,CLOAD1
        MOVLW   8
        MOVWF   I

SHIFT1  BTFSC   TXSR,7
        BSF     PORTC,CDATA1
        BTFSS   TXSR,7
        BCF     PORTC,CDATA1

        BCF     PORTC,CCLK1
        RLF     TXSR            ; DO SOMETHING
        BSF     PORTC,CCLK1

        DECFSZ  I
        GOTO    SHIFT1
        RETLW   0

        ORG     PIC57
RESET   GOTO    INIT
