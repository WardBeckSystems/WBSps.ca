        LIST    F=INHX8M,R=DEC,P=16C57
; ----------   PIC16C5X HEADER   ----------

W       EQU     0

; RESET ADDRESSES

PIC54   EQU     $1FF
PIC55   EQU     $1FF
PIC56   EQU     $3FF
PIC57   EQU     $7FF

; STATUS WORD REGISTER f3

C       EQU     0
DC      EQU     1
Z       EQU     2
PD      EQU     3
TO      EQU     4
PA0     EQU     5
PA1     EQU     6
PA2     EQU     7

; OPERATIONAL REGISTER FILES

IND     EQU     00
RTCC    EQU     01
PC      EQU     02
STATUS  EQU     03
FSR     EQU     04
PORTA   EQU     05
PORTB   EQU     06
PORTC   EQU     07

; ----------   END HEADER   ----------

TXSR    EQU     08              ; TX SHIFT REGISTER
I       EQU     09              ; INDEX

KS1     EQU     10              ; SHAFT ENCODER DBOUNCE STATE
KS2     EQU     11

STATE2  EQU     12              ; SHAFT ENCODER ROTATION STATE

TEMP    EQU     13
NUM     EQU     14
LEVEL   EQU     15

D0      EQU     16              ; LCD DIGITS
D1      EQU     17
D2      EQU     18
D3      EQU     19

DEL     EQU     20
CNT     EQU     21
TMR     EQU     22

MKON    EQU     23              ; KEYPAD DEBOUNCE STATES
MKOFF   EQU     24

KP6     EQU     25
KM6     EQU     26
KOFF    EQU     27

KPAH    EQU     28
KPAM    EQU     29
KPAL    EQU     30

RETC    EQU     31

; ----------   RETC FLAGS   ----------

DISPF   EQU     2
TMRF    EQU     3

; ----------   PORTA BITS   ----------

CDATA1   EQU     0               ; CS3310
CCLK1    EQU     1
CLOAD1   EQU     2
CMUTE    EQU     3

DATA2   EQU     0               ; LCD
CLK2    EQU     1

; ----------   PORTB BITS   ----------

ROW1    EQU     0
ROW2    EQU     1
ROW3    EQU     2
ROW4    EQU     3

COL1    EQU     4
COL2    EQU     5
COL3    EQU     6
COL4    EQU     7               ; UNUSED

; ----------   PORTC BITS   ----------

K1      EQU     0               ; SHAFT ENCODER
K2      EQU     1

LOAD2   EQU     2               ; LCD
GAIN6   EQU     3               ; PREAMP 0 -> -6dB , 1 -> +6dB
HIGH    EQU     4               ; PREAMP 0 TO 30 dB RANGE
MID     EQU     5               ; PREAMP -30 TO 0 dB RANGE
RELAYS  EQU     6               ; PREAMP 6.25 ms PULSE TO SET RELAY
RELAYC  EQU     7               ; PREAMP 6.25 ms PULSE TO CLEAR RELAY

; ----------   EQUATES   ----------

                                ; USE 4.00 MHz CRYSTAL AND TWO 15pF CAPS
                                ; OS2 = 1 MHz
DELAY   EQU     100             ; 1.25 msec with OPTION $02 ( RTCC=OS2/8 )
; DELAY   EQU     100             ; 5 msec with OPTION $04 ( RTCC=OS2/32 )

; ----------   JUMP TABLE   ----------

        ORG     $000
TXDIS   GOTO    RTXDIS
TXB1    GOTO    RTXB1
SCAN    GOTO    RSCAN

; ----------   MAIN CODE   ----------

MAIN1   CALL    SCAN
        MOVF    RETC,W
        ANDLW   $07
        ADDWF   PC
        GOTO    SCANR1
        GOTO    SCANR2
        GOTO    SCANR3
        GOTO    NOTHING
        GOTO    DISPLAY
        GOTO    DISPLAY
        GOTO    DISPLAY
        GOTO    DISPLAY

; ----------   NEXT STATE TABLE1   ----------
                        ; SET BIT 0 OF THE STATE TO INPUT
                        ; BEFORE CALLING NEXT1
KEYBIT  EQU     3       ; BIT TEST KEYBIT AFTER CALLING NEXT1
KCH     EQU     4

NEXT1   ANDLW   $0F     ; DEBOUNCE INPUT STATE MACHINE
        ADDWF   PC

        RETLW   0       ; KEYBIT CLEAR WHILE INPUT=0
        RETLW   2
        RETLW   0
        RETLW   4
        RETLW   0
        RETLW   6
        RETLW   0
        RETLW   8+16    ; 4TH INPUT=1 SO SET KEYBIT

        RETLW   10
        RETLW   8       ; KEYBIT SET WHILE INPUT=1
        RETLW   12
        RETLW   8
        RETLW   14
        RETLW   8
        RETLW   0+16    ; 4TH INPUT=0 SO CLEAR KEYBIT
        RETLW   8

; ----------   DIGITS LOOKUP TABLE3   ----------

DIGITS  ANDLW   $0F
        ADDWF   PC

        RETLW   $3F             ; 0
        RETLW   $06             ; 1
        RETLW   $5B             ; 2
        RETLW   $4F             ; 3

        RETLW   $66             ; 4
        RETLW   $6D             ; 5
        RETLW   $7D             ; 6
        RETLW   $07             ; 7

        RETLW   $7F             ; 8
        RETLW   $6F             ; 9
        RETLW   $77             ; A
        RETLW   $7C             ; B

        RETLW   $39             ; C
        RETLW   $5E             ; D
        RETLW   $79             ; E
        RETLW   $71             ; F

; ----------   NEXT STATE TABLE2   ----------

TINC    EQU     7
TDEC    EQU     6
TCH     EQU     5

NEXT2   ANDLW   $1F
        ADDWF   PC
; DOWN
        RETLW   $00+$00
        RETLW   $04+$40         ; DEC
        RETLW   $18+$A0         ; INC  CHANGE
        RETLW   $0C+$00

        RETLW   $10+$A0         ; INC  CHANGE
        RETLW   $04+$00
        RETLW   $08+$00
        RETLW   $0C+$40         ; DEC

        RETLW   $00+$40         ; DEC
        RETLW   $04+$00
        RETLW   $08+$00
        RETLW   $1C+$A0         ; INC  CHANGE

        RETLW   $00+$00
        RETLW   $14+$A0         ; INC  CHANGE
        RETLW   $08+$40         ; DEC
        RETLW   $0C+$00
; UP
        RETLW   $10+$00
        RETLW   $04+$60         ; DEC  CHANGE
        RETLW   $18+$80         ; INC
        RETLW   $1C+$00

        RETLW   $10+$80         ; INC
        RETLW   $14+$00
        RETLW   $18+$00
        RETLW   $0C+$60         ; DEC  CHANGE

        RETLW   $00+$60         ; DEC  CHANGE
        RETLW   $14+$00
        RETLW   $18+$00
        RETLW   $1C+$80         ; INC

        RETLW   $10+$00
        RETLW   $14+$80         ; INC
        RETLW   $08+$60         ; DEC  CHANGE
        RETLW   $1C+$00

; ----------   TRANSLATION TABLE4   ----------

TRANS4  ANDLW   $7F
        ADDWF   PC
        RETLW   $00
        RETLW   $01
        RETLW   $02
        RETLW   $03
        RETLW   $04
        RETLW   $05
        RETLW   $06
        RETLW   $07

        RETLW   $08
        RETLW   $09
        RETLW   $10
        RETLW   $11
        RETLW   $12
        RETLW   $13
        RETLW   $14
        RETLW   $15

        RETLW   $16
        RETLW   $17
        RETLW   $18
        RETLW   $19
        RETLW   $20
        RETLW   $21
        RETLW   $22
        RETLW   $23

        RETLW   $24
        RETLW   $25
        RETLW   $26
        RETLW   $27
        RETLW   $28
        RETLW   $29
        RETLW   $30
        RETLW   $31

        RETLW   $32
        RETLW   $33
        RETLW   $34
        RETLW   $35
        RETLW   $36
        RETLW   $37
        RETLW   $38
        RETLW   $39

        RETLW   $40
        RETLW   $41
        RETLW   $42
        RETLW   $43
        RETLW   $44
        RETLW   $45
        RETLW   $46
        RETLW   $47

        RETLW   $48
        RETLW   $49
        RETLW   $50
        RETLW   $51
        RETLW   $52
        RETLW   $53
        RETLW   $54
        RETLW   $55

        RETLW   $56
        RETLW   $57
        RETLW   $58
        RETLW   $59
        RETLW   $60
        RETLW   $61
        RETLW   $62
        RETLW   $63

        RETLW   $64
        RETLW   $65
        RETLW   $66
        RETLW   $67
        RETLW   $68
        RETLW   $69
        RETLW   $70
        RETLW   $71

        RETLW   $72
        RETLW   $73
        RETLW   $74
        RETLW   $75
        RETLW   $76
        RETLW   $77
        RETLW   $78
        RETLW   $79

        RETLW   $80
        RETLW   $81
        RETLW   $82
        RETLW   $83
        RETLW   $84
        RETLW   $85
        RETLW   $86
        RETLW   $87

        RETLW   $88
        RETLW   $89
        RETLW   $90
        RETLW   $91
        RETLW   $92
        RETLW   $93
        RETLW   $94
        RETLW   $95

        RETLW   $FF

; ----------   CODE   ----------

; ----------   INITIALIZATION CODE   ----------

        ORG     $0C0
INIT    XORLW   $FF             ; UNPROGRAMED NOP

        CLRF    PORTA           ; INITIALIZE PORTA
        CLRW
        TRIS    PORTA

        MOVLW   $FE             ; INITIALIZE PORTB
        MOVWF   PORTB
        MOVLW   $F0
        TRIS    PORTB

        MOVLW   $10
        MOVWF   PORTC           ; INITIALIZE PORTC
        MOVLW   $03
        TRIS    PORTC

        MOVLW   $02             ; RTCC = OSC2 / 8
        OPTION

        MOVLW   DELAY           ; RESET COUNTER
        MOVWF   RTCC

        BSF     PORTA,CLOAD1

        CLRF    KS1
        CLRF    KS2
        CLRF    STATE2

        CLRF    D3
        CLRF    D2
        CLRF    D1
        CLRF    D0
        CLRF    LEVEL

        CLRF    MKON
        CLRF    MKOFF
        CLRF    KP6
        CLRF    KM6
        CLRF    KOFF
        CLRF    KPAH
        CLRF    KPAM
        CLRF    KPAL

        MOVLW   4
        MOVWF   RETC
        MOVLW   4
        MOVWF   CNT
        MOVLW   5
        MOVWF   TMR
        MOVLW   10
        MOVWF   DEL
        GOTO    MAIN1

; ----------   SCANR1   ----------

SCANR1
        BTFSS   PORTB,COL1
        INCF    MKON
        MOVF    MKON,W
        CALL    NEXT1
        MOVWF   MKON

        BTFSS   PORTB,COL2
        INCF    KP6
        MOVF    KP6,W
        CALL    NEXT1
        MOVWF   KP6

        BTFSS   PORTB,COL3
        INCF    KPAH
        MOVF    KPAH,W
        CALL    NEXT1
        MOVWF   KPAH

        BTFSC   MKON,KEYBIT
        BCF     PORTA,CMUTE
        BTFSC   KP6,KEYBIT
        BSF     PORTC,GAIN6

        BTFSS   KPAH,KCH
        GOTO    SKR1
        BTFSS   KPAH,KEYBIT
        GOTO    SKR1
        BTFSC   RETC,TMRF
        GOTO    SKR1
        BCF     PORTC,HIGH
        BSF     PORTC,MID
        BSF     PORTC,RELAYC
        BSF     RETC,TMRF

SKR1    MOVLW   $FD
        MOVWF   PORTB
        MOVLW   $FC
        ANDWF   RETC
        MOVLW   $01
        IORWF   RETC
        GOTO    MAIN1

; ----------   SCANR2   ----------

SCANR2
        BTFSS   PORTB,COL1
        INCF    MKOFF
        MOVF    MKOFF,W
        CALL    NEXT1
        MOVWF   MKOFF

        BTFSS   PORTB,COL2
        INCF    KM6
        MOVF    KM6,W
        CALL    NEXT1
        MOVWF   KM6

        BTFSS   PORTB,COL3
        INCF    KPAM
        MOVF    KPAM,W
        CALL    NEXT1
        MOVWF   KPAM

        BTFSC   MKOFF,KEYBIT
        BSF     PORTA,CMUTE
        BTFSC   KM6,KEYBIT
        BCF     PORTC,GAIN6

        BTFSS   KPAM,KCH
        GOTO    SKR2
        BTFSS   KPAM,KEYBIT
        GOTO    SKR2
        BTFSC   RETC,TMRF
        GOTO    SKR2
        BSF     PORTC,HIGH
        BCF     PORTC,MID
        BSF     PORTC,RELAYC
        BSF     RETC,TMRF

SKR2    MOVLW   $FB
        MOVWF   PORTB
        MOVLW   $FC
        ANDWF   RETC
        MOVLW   $02
        IORWF   RETC
        GOTO    MAIN1

; ----------   SCANR3   ----------

SCANR3
        BTFSS   PORTB,COL2
        INCF    KOFF
        MOVF    KOFF,W
        CALL    NEXT1
        MOVWF   KOFF

        BTFSS   PORTB,COL3
        INCF    KPAL
        MOVF    KPAL,W
        CALL    NEXT1
        MOVWF   KPAL

        BTFSS   KOFF,KCH
        GOTO    SKR31
        BTFSS   KOFF,KEYBIT
        GOTO    SKR31
        BTFSC   RETC,TMRF
        GOTO    SKR31
        BSF     PORTC,HIGH
        BSF     PORTC,MID
        BSF     PORTC,RELAYC
        BSF     RETC,TMRF
        GOTO    SKR32

SKR31   BTFSS   KPAL,KCH
        GOTO    SKR32
        BTFSS   KPAL,KEYBIT
        GOTO    SKR32
        BTFSC   RETC,TMRF
        GOTO    SKR32
        BSF     PORTC,HIGH
        BSF     PORTC,MID
        BSF     PORTC,RELAYS
        BSF     RETC,TMRF

SKR32   MOVLW   $F7
        MOVWF   PORTB
        MOVLW   $FC
        ANDWF   RETC
        MOVLW   $03
        IORWF   RETC
        GOTO    MAIN1

; ----------   NOTHING   ----------

NOTHING MOVLW   $FE
        MOVWF   PORTB
        MOVLW   $FC
        ANDWF   RETC
        MOVLW   $00
        IORWF   RETC
        GOTO    MAIN1

; ----------   DISPLAY   ----------

DISPLAY MOVLW   192
        SUBWF   LEVEL,W
        MOVWF   TEMP
        BTFSS   STATUS,C
        GOTO    MINUS           ; LEVEL < 192
                                ; LEVEL >= 192
PLUS    MOVLW   $26
        MOVWF   D3
        GOTO    OPNUM

MINUS   MOVLW   $24
        MOVWF   D3
        COMF    TEMP
        INCF    TEMP

OPNUM   RRF     TEMP,W
        CALL    TRANS4
        MOVWF   NUM
        SWAPF   NUM,W
        CALL    DIGITS
        MOVWF   D2
        MOVF    NUM,W
        CALL    DIGITS
        MOVWF   D1

        MOVLW   0
        BTFSC   TEMP,0
        MOVLW   5
        CALL    DIGITS
        MOVWF   D0

        MOVF    LEVEL,W
        CALL    TXB1
        MOVF    LEVEL,W
        CALL    TXB1
        BSF     PORTA,CLOAD1

        CALL    SCAN
        MOVF    D3,W
        CALL    TXDIS
        CALL    SCAN
        MOVF    D2,W
        CALL    TXDIS
        CALL    SCAN
        MOVF    D1,W
        CALL    TXDIS
        CALL    SCAN
        MOVF    D0,W
        CALL    TXDIS

        BSF     PORTC,LOAD2
        NOP
        BCF     PORTC,LOAD2

        BCF     RETC,DISPF
        GOTO    MAIN1


; ----------   SCAN SUBROUTINE  ----------

RSCAN
W1      MOVF    RTCC,W
        BTFSS   STATUS,Z
        GOTO    W1              ; WAIT FOR TIME OUT

        MOVLW   DELAY
        MOVWF   RTCC            ; RESET COUNTER

        DECFSZ  CNT
        GOTO    DONT

DO      MOVLW   4               ; ON 4TH CNT RESET TO 4 AND DEC DEL
        MOVWF   CNT
        DECF    DEL
        BTFSC   STATUS,Z
        INCF    DEL             ; MIN DEL IS 1
DONT
        BTFSS   RETC,TMRF
        GOTO    NOPULSE
        DECFSZ  TMR
        GOTO    NOPULSE
        MOVLW   5
        MOVWF   TMR
        BCF     PORTC,RELAYC
        BCF     PORTC,RELAYS
        BCF     RETC,TMRF

NOPULSE
        BTFSC   PORTC,0
        INCF    KS1
        MOVF    KS1,W
        CALL    NEXT1
        MOVWF   KS1

        BTFSC   PORTC,1
        INCF    KS2
        MOVF    KS2,W
        CALL    NEXT1
        MOVWF   KS2

        BTFSC   KS1,KEYBIT
        BSF     STATE2,0
        BTFSC   KS2,KEYBIT
        BSF     STATE2,1
        MOVF    STATE2,W
        CALL    NEXT2
        MOVWF   STATE2

INC_L   BTFSS   STATE2,TINC
        GOTO    DEC_L

        MOVF    DEL,W
        ADDWF   LEVEL,W
        BTFSC   STATUS,C
        MOVLW   255
        MOVWF   LEVEL

        BSF     RETC,DISPF
        MOVLW   4
        MOVWF   CNT
        MOVLW   10
        MOVWF   DEL
        RETLW   0

DEC_L   BTFSS   STATE2,TDEC
        RETLW   0

        MOVF    DEL,W
        SUBWF   LEVEL,W
        BTFSS   STATUS,C
        MOVLW   0
        MOVWF   LEVEL

        BSF     RETC,DISPF
        MOVLW   4
        MOVWF   CNT
        MOVLW   10
        MOVWF   DEL
        RETLW   0

; ----------   TX SUBROUTINE   ----------

RTXDIS   MOVWF   TXSR           ; LCD
        BCF     PORTC,LOAD2
        MOVLW   8
        MOVWF   I

SHIFT2  BTFSC   TXSR,7
        BSF     PORTA,DATA2
        BTFSS   TXSR,7
        BCF     PORTA,DATA2

        BSF     PORTA,CLK2
        RLF     TXSR            ; DO SOMETHING
        BCF     PORTA,CLK2

        DECFSZ  I
        GOTO    SHIFT2
        RETLW   0

; ----------   TXB1 SUBROUTINE   ----------

RTXB1    MOVWF   TXSR                   ; CS3310
        BCF     PORTA,CLOAD1
        MOVLW   8
        MOVWF   I

SHIFT1  BTFSC   TXSR,7
        BSF     PORTA,CDATA1
        BTFSS   TXSR,7
        BCF     PORTA,CDATA1

        BCF     PORTA,CCLK1
        RLF     TXSR            ; DO SOMETHING
        BSF     PORTA,CCLK1

        DECFSZ  I
        GOTO    SHIFT1
        RETLW   0

        ORG     PIC57
RESET   GOTO    INIT
        END
