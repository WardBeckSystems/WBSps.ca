; ----------   CODE   ----------

        ORG     $100
        XORLW   $FF             ; UNPROGRAMMED NOP

        CLRF    PORTB
        CLRW
        TRIS    PORTB

        MOVLW   $0F
        TRIS    PORTA

        CLRF    STATE1
        CLRF    STATE2
        CLRF    COUNT
        CLRF    LEVEL

MAINT   MOVF    COUNT,W
        CALL    TAB3
        MOVWF   LEVEL

MAINL   MOVF    LEVEL,W
        MOVWF   PORTB

        MOVLW   $1C             ; CLEAN UP STATES
        ANDWF   STATE1
        ANDWF   STATE2

        MOVF    PORTA,W

        ANDLW   $03
        IORWF   STATE1,W
        CALL    NEXT1
        MOVWF   STATE1

        MOVLW   187
        SUBWF   COUNT,W
        BTFSS   STATUS,C
        GOTO    USETAB3         ; COUNT < 187
                                ; COUNT >= 187
        MOVF    STATE1,W
        ANDLW   $03
        IORWF   STATE2,W
        CALL    NEXT2
        MOVWF   STATE2

        BTFSC   STATE2,0
        GOTO    DEC_L
        BTFSC   STATE2,1
        GOTO    INC_L
        GOTO    MAINL

INC_L   MOVLW   255
        SUBWF   LEVEL,W
        BTFSS   STATUS,C
        INCF    LEVEL           ; LEVEL < 255
        GOTO    MAINL           ; LEVEL >= 255

DEC_L   DECF    LEVEL
        MOVLW   179             ; NEXT TIME USE TABLE
        SUBWF   LEVEL,W         ; IF LEVEL < 179
        BTFSC   STATUS,C
        GOTO    MAINL           ; LEVEL >= 179
        DECF    COUNT           ; LEVEL < 179
        GOTO    MAINT

USETAB3 BTFSC   STATE1,0
        GOTO    DEC_C
        BTFSC   STATE1,1
        GOTO    INC_C
        GOTO    MAINT

INC_C   INCF    COUNT
        MOVLW   187
        SUBWF   COUNT,W
        BTFSS   STATUS,C
        GOTO    MAINT           ; COUNT < 187
        MOVLW   4               ; COUNT >= 187
        MOVWF   STATE2
        INCF    LEVEL
        GOTO    MAINL

DEC_C   MOVLW   1
        SUBWF   COUNT,W
        BTFSC   STATUS,C
        DECF    COUNT           ; COUNT >= 1
        GOTO    MAINT           ; COUNT < 1

        ORG     PIC54
RESET   GOTO    $100
