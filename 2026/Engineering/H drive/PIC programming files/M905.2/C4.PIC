; ----------   PIC16C5X HEADER   ----------

W       EQU     0

; RESET ADDRESSES

PIC54   EQU     $1FF
PIC55   EQU     $1FF
PIC56   EQU     $3FF
PIC57   EQU     $7FF

; STATUS WORD REGISTER f3

C       EQU     0
DC      EQU     1
Z       EQU     2
PD      EQU     3
TO      EQU     4
PA0     EQU     5
PA1     EQU     6
PA2     EQU     7

; OPERATIONAL REGISTER FILES

IND     EQU     00
RTCC    EQU     01
PC      EQU     02
STATUS  EQU     03
FSR     EQU     04
PORTA   EQU     05
PORTB   EQU     06
PORTC   EQU     07

; ----------   END HEADER   ----------

STATE1  EQU     08
STATE2  EQU     09
COUNT   EQU     10
LEVEL   EQU     11

; ----------   NEXT STATE TABLE1   ----------

        ORG     $000

NEXT1   ANDLW   $1F
        ADDWF   PC

        RETLW   0
        RETLW   20
        RETLW   8+$02   ; INC
        RETLW   0

        RETLW   0+$02   ; INC
        RETLW   4
        RETLW   4
        RETLW   28

        RETLW   16
        RETLW   8
        RETLW   8
        RETLW   12+$02  ; INC

        RETLW   12
        RETLW   4+$02   ; INC
        RETLW   24
        RETLW   12

        RETLW   16
        RETLW   20+$01  ; DEC
        RETLW   8
        RETLW   16

        RETLW   0
        RETLW   20
        RETLW   20
        RETLW   28+$01  ; DEC

        RETLW   16+$01  ; DEC
        RETLW   24
        RETLW   24
        RETLW   12

        RETLW   28
        RETLW   4
        RETLW   24+$01  ; DEC
        RETLW   28

; ----------   NEXT STATE TABLE2   ----------

NEXT2   ANDLW   $1F
        ADDWF   PC

        RETLW   0
        RETLW   28
        RETLW   4+$02   ; INC
        RETLW   0

        RETLW   4
        RETLW   0+$01   ; DEC
        RETLW   8
        RETLW   4

        RETLW   8
        RETLW   4
        RETLW   12
        RETLW   8

        RETLW   12
        RETLW   8
        RETLW   16
        RETLW   12

        RETLW   16
        RETLW   12
        RETLW   20
        RETLW   16

        RETLW   20
        RETLW   16
        RETLW   24
        RETLW   20

        RETLW   24
        RETLW   20
        RETLW   28
        RETLW   24

        RETLW   28
        RETLW   24
        RETLW   0
        RETLW   28

; ----------   LOOKUP TABLE3   ----------

TAB3    ADDWF   PC

        RETLW     0
        RETLW     2
        RETLW     4
        RETLW     5
        RETLW     7
        RETLW     9
        RETLW    11
        RETLW    12

        RETLW    14
