; ----------   PIC16C5X HEADER   ----------

W       EQU     0

; RESET ADDRESSES

PIC54   EQU     $1FF
PIC55   EQU     $1FF
PIC56   EQU     $3FF
PIC57   EQU     $7FF

; STATUS WORD REGISTER f3

C       EQU     0
DC      EQU     1
Z       EQU     2
PD      EQU     3
TO      EQU     4
PA0     EQU     5
PA1     EQU     6
PA2     EQU     7

; OPERATIONAL REGISTER FILES

IND     EQU     00
RTCC    EQU     01
PC      EQU     02
STATUS  EQU     03
FSR     EQU     04
PORTA   EQU     05
PORTB   EQU     06
PORTC   EQU     07

; ----------   END HEADER   ----------

KEY     EQU     08
KEYST   EQU     09
TXSR    EQU     10              ; TX SHIFT REGISTER
ROW     EQU     10
I       EQU     11
DISPLAY EQU     12
FLAGS   EQU     13
COUNT   EQU     14
PTR     EQU     15

; ----------   PORTA BITS   ----------

DATA1   EQU     0               ; DISPLAY
CLK1    EQU     1
LOAD1   EQU     2
EXTRA   EQU     3               ; UNUSED

; ----------   PORTB BITS   ----------

ROW1    EQU     0
ROW2    EQU     1
ROW3    EQU     2
ROW4    EQU     3

COL1    EQU     4
COL2    EQU     5
COL3    EQU     6
COL4    EQU     7               ; UNUSED

; ----------   EQUATES   ----------

                                ; USE 4.00 MHz CRYSTAL AND TWO 15pF CAPS
                                ; OS2 = 1 MHz
DELAY   EQU     100             ; 5 msec with OPTION $04 ( RTCC=OS2/32 )

; ----------   NEXT STATE TABLE1   ----------

        ORG     $000
                        ; SET BIT 0 OF THE STATE TO INPUT
                        ; BEFORE CALLING NEXT1
KEYBIT  EQU     3       ; BIT TEST KEYBIT AFTER CALLING NEXT1

NEXT1   ANDLW   $0F     ; DEBOUNCE INPUT STATE MACHINE
        ADDWF   PC

        RETLW   0       ; KEYBIT CLEAR WHILE INPUT=0
        RETLW   2
        RETLW   0
        RETLW   4
        RETLW   0
        RETLW   6
        RETLW   0
        RETLW   8       ; 4TH INPUT=1 SO SET KEYBIT

        RETLW   10
        RETLW   8       ; KEYBIT SET WHILE INPUT=1
        RETLW   12
        RETLW   8
        RETLW   14
        RETLW   8
        RETLW   0       ; 4TH INPUT=0 SO CLEAR KEYBIT
        RETLW   8

; ----------   KEYCODE TABLE2   ----------

KEYCODE ANDLW   $0F
        ADDWF   PC

        RETLW   $0D
        RETLW   $01
        RETLW   $02
        RETLW   $03

        RETLW   $0A
        RETLW   $04
        RETLW   $05
        RETLW   $06

        RETLW   $0B
        RETLW   $07
        RETLW   $08
        RETLW   $09

        RETLW   $0C
        RETLW   $0E
        RETLW   $00
        RETLW   $0F

; ----------   DIGITS LOOKUP TABLE3   ----------

DIGITS  ANDLW   $0F
        ADDWF   PC

        RETLW   $3F             ; 0
        RETLW   $06             ; 1
        RETLW   $5B             ; 2
        RETLW   $4F             ; 3

        RETLW   $66             ; 4
        RETLW   $6D             ; 5
        RETLW   $7D             ; 6
        RETLW   $07             ; 7

        RETLW   $7F             ; 8
        RETLW   $6F             ; 9
        RETLW   $77             ; A
        RETLW   $7C             ; B

        RETLW   $39             ; C
        RETLW   $5E             ; D
        RETLW   $79             ; E
        RETLW   $71             ; F

; ----------   TXB1 SUBROUTINE   ----------

TXB1    MOVWF   TXSR
TX1     BCF     PORTA,LOAD1
        MOVLW   8
        MOVWF   I

SHIFT1  BTFSC   TXSR,7
        BSF     PORTA,DATA1
        BTFSS   TXSR,7
        BCF     PORTA,DATA1

        BCF     PORTA,CLK1
        RLF     TXSR            ; DO SOMETHING
        NOP
        BSF     PORTA,CLK1

        DECFSZ  I
        GOTO    SHIFT1
        RETLW   0

; ----------   TEST SUBROUTINE   ----------

TEST    BTFSS   PORTB,COL1
        RETLW   00
        INCF    I
        BTFSS   PORTB,COL2
        RETLW   00
        INCF    I
        BTFSS   PORTB,COL3
        RETLW   00
        INCF    I
        RETLW   01

; ----------   SCANR SUBROUTINE   ----------

SCANR   MOVF    ROW,W
        MOVWF   PORTB
        CALL    TEST
        ADDWF   PC
        GOTO    KEYHIT          ; STACK OVERFLOW - SO WHAT
        RLF    ROW
        RETLW   00

; ----------   INITIALIZATION CODE   ----------

        ORG     $100
INIT    XORLW   $FF             ; UNPROGRAMED NOP

        CLRF    PORTA           ; INITIALIZE PORTA
        MOVLW   $08
        TRIS    PORTA

        MOVLW   $FF             ; INITIALIZE PORTB
        MOVWF   PORTB
        MOVLW   $F0
        TRIS    PORTB

        MOVLW   $FF             ; INITIALIZE PORTC
        MOVWF   PORTC
        CLRW
        TRIS    PORTC

        MOVLW   $FF             ; TURN ON DISPLAY
        CALL    TXB1
        MOVLW   $FF
        CALL    TXB1
        BSF     PORTA,LOAD1



;        MOVLW   KEYST           ; BLANK INPUT AND KEYSWITCH STATES
;        MOVWF   FSR
;        MOVLW   NKEYS
;        MOVWF   I
;BLANK   CLRF    IND
;        INCF    FSR
;        DECFSZ  I
;        GOTO    BLANK



        MOVLW   $04             ; RTCC = OSC2 / 32
        OPTION

        MOVLW   255
        MOVWF   I

SEQ1
        MOVF    RTCC,W
        BTFSS   STATUS,Z
        GOTO    SEQ1            ; WAIT FOR TIME OUT

        MOVLW   DELAY           ; RESET COUNTER
        MOVWF   RTCC

        DECFSZ  I
        GOTO    SEQ1

        CLRF    DISPLAY
        CLRF    KEY
        CLRF    KEYST
        CLRF    FLAGS

; ----------   MAIN CODE   ----------

WAIT    MOVF    RTCC,W
        BTFSS   STATUS,Z
        GOTO    WAIT            ; WAIT FOR TIME OUT

        MOVLW   DELAY
        MOVWF   RTCC            ; RESET COUNTER

SCAN    MOVLW   $0E
        MOVWF   ROW
        MOVLW   01
        MOVWF   I
        CALL    SCANR
        CALL    SCANR
        CALL    SCANR
        CALL    SCANR
        MOVLW   $FF
        MOVWF   PORTB

        MOVF    KEYST,W
        CALL    NEXT1
        MOVWF   KEYST

UPDD    SWAPF   DISPLAY,W
        CALL    DIGITS
        MOVWF   TXSR
        CALL    TX1
        MOVF    DISPLAY,W
        CALL    DIGITS
        MOVWF   TXSR
        BSF     TXSR,7
        CALL    TX1
        BSF     PORTA,LOAD1

        GOTO    WAIT

KEYHIT  INCF    KEYST,W
        CALL    NEXT1
        MOVWF   KEYST

        BTFSS   KEYST,KEYBIT
        GOTO    WAIT

        MOVLW   $0F
        ANDWF   DISPLAY
        SWAPF   DISPLAY
        MOVF    I,W
        IORWF   DISPLAY
        GOTO    WAIT

        ORG     PIC57
RESET   GOTO    INIT
