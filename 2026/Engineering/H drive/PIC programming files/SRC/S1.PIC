; ----------   PIC16C5X HEADER   ----------

W       EQU     0

; RESET ADDRESSES

PIC54   EQU     $1FF
PIC55   EQU     $1FF
PIC56   EQU     $3FF
PIC57   EQU     $7FF

; STATUS WORD REGISTER f3

C       EQU     0
DC      EQU     1
Z       EQU     2
PD      EQU     3
TO      EQU     4
PA0     EQU     5
PA1     EQU     6
PA2     EQU     7

; OPERATIONAL REGISTER FILES

IND     EQU     00
RTCC    EQU     01
PC      EQU     02
STATUS  EQU     03
FSR     EQU     04
PORTA   EQU     05
PORTB   EQU     06
PORTC   EQU     07

; ----------   END HEADER   ----------

I       EQU     8
ROW     EQU     9
KEYCODE EQU     10
DISPLAY EQU     11

KS0     EQU     16      ; KEYSWITCH TABLE
KS1     EQU     17
KS2     EQU     18
KS3     EQU     19
KS4     EQU     20
KS5     EQU     21
KS6     EQU     22
KS7     EQU     23
KS8     EQU     24
KS9     EQU     25
KSA     EQU     26
KSB     EQU     27
KSC     EQU     28
KSD     EQU     29
KSE     EQU     30
KSF     EQU     31

; ----------   NEXT STATE TABLE1   ----------

        ORG     $000

NEXT1   ANDLW   $0F     ; DEBOUNCE INPUT STATE MACHINE
        ADDWF   PC

        RETLW   0
        RETLW   2
        RETLW   0
        RETLW   4
        RETLW   0
        RETLW   6
        RETLW   0
        RETLW   8

        RETLW   10
        RETLW   8
        RETLW   12
        RETLW   8
        RETLW   14
        RETLW   8
        RETLW   0
        RETLW   8

; ----------   DISPLAY TRASLATION TABLE2   ----------

TRANS2  ANDLW   $0F
        ADDWF   PC

        RETLW   64+0
        RETLW   128+0
        RETLW   64+1
        RETLW   128+1
        RETLW   64+2
        RETLW   128+2
        RETLW   64+3
        RETLW   128+3

        RETLW   64+4
        RETLW   128+4
        RETLW   64+5
        RETLW   128+5
        RETLW   64+6
        RETLW   128+6
        RETLW   64+7
        RETLW   128+7

; ----------   CODE   ----------

        ORG     $101

NROWS   EQU     8
NKEYS   EQU     16
DELAY1  EQU     110             ; 125 msec with OPTION $06
DELAY2  EQU     69              ;   5 msec with OPTION $01

INIT    CLRF    PORTA           ; INITIALIZE PORTA
        CLRW
        TRIS    PORTA

        MOVLW   128+7           ; INITIALIZE PORTB
        MOVWF   PORTB
        MOVLW   $38
        TRIS    PORTB

        MOVLW   KS0             ; BLANK KEYSWITCH TABLE
        MOVWF   FSR
        MOVLW   NKEYS
        MOVWF   I

BLANK   CLRF    IND
        INCF    FSR
        DECFSZ  I
        GOTO    BLANK

        CLRW                    ; INITIALIZE DISPLAY
        MOVWF   KEYCODE
        CALL    TRANS2
        MOVWF   DISPLAY

        MOVLW   NKEYS           ; SEQUENCE THROUGH LEDs
        MOVWF   I

        MOVLW   $06             ; RTCC = OSC2 / 128
        OPTION
SEQ1    MOVLW   DELAY1          ; RESET COUNTER
        MOVWF   RTCC

        DECF    I,W
        CALL    TRANS2
        MOVWF   PORTB

SEQ2    MOVF    RTCC,W
        BTFSS   STATUS,Z
        GOTO    SEQ2            ; WAIT FOR TIME OUT

        DECFSZ  I
        GOTO    SEQ1

        MOVLW   $01             ; RTCC = OSC2 / 4
        OPTION
        MOVLW   DELAY2          ; RESET COUNTER
        MOVWF   RTCC
WAIT
NONE
MAIN    MOVF    RTCC,W
        BTFSS   STATUS,Z
        GOTO    MAIN            ; WAIT FOR TIME OUT

        MOVLW   DELAY2
        MOVWF   RTCC            ; RESET COUNTER

        MOVLW   KS0
        MOVWF   FSR
        MOVLW   NROWS
        MOVWF   I
        MOVLW   $C0             ; TURN OFF LEDs
        MOVWF   ROW

SCAN    MOVF    ROW,W           ; SCAN KEYBOARD
        MOVWF   PORTB
        INCF    ROW

        BTFSC   PORTB,5
        INCF    IND
        MOVF    IND,W
        CALL    NEXT1
        MOVWF   IND
        INCF    FSR

        BTFSC   PORTB,4
        INCF    IND
        MOVF    IND,W
        CALL    NEXT1
        MOVWF   IND
        INCF    FSR

        DECFSZ  I
        GOTO    SCAN

        MOVF    DISPLAY,W       ; RESTORE DISPLAY
        MOVWF   PORTB           ; AFTER KEYBOARD SCAN

        BTFSS   PORTB,3
        GOTO    DONT            ; DON'T WAIT FOR RELEASE

        MOVLW   KS0
        ADDWF   KEYCODE,W
        MOVWF   FSR
        BTFSS   IND,3
        GOTO    WAIT            ; WAIT FOR RELEASE

DONT    MOVLW   KS0             ; GET HIGHEST PRIORITY KEY
        MOVWF   FSR
        MOVLW   NKEYS
        MOVWF   I

PRIO    BTFSS   IND,3
        GOTO    DONE

        INCF    FSR
        DECFSZ  I
        GOTO    PRIO
        GOTO    NONE

DONE    MOVLW   KS0
        SUBWF   FSR,W
        MOVWF   KEYCODE
        MOVWF   PORTA           ; OUTPUT NEW KEYCODE
        CALL    TRANS2          ; GET NEW DISPLAY VALUE
        MOVWF   DISPLAY
        GOTO    MAIN

        ORG     PIC54
RESET   GOTO    $100





; ----------   END HEADER   ----------

LEVEL   EQU     08
STATE1  EQU     09              ; ENCODER STATE
TXSR    EQU     10              ; TX SHIFT REGISTER
I       EQU     11
TEMP    EQU     12
NUM     EQU     13

; ----------   PORTB BITS   ----------

DATA1   EQU     0
CLK1    EQU     1
LOAD1   EQU     2

DATA2   EQU     4
CLK2    EQU     5
LOAD2   EQU     6

TESTB   EQU     7               ; OUTPUT LEVEL IF BIT LOW

; ----------   JUMP TABLE   ----------

        ORG     $000

TXGAIN  GOTO    TXB1
TXDIS   GOTO    TXB2

; ----------   NEXT STATE TABLE1   ----------

NEXT1   ANDLW   $0F
        ADDWF   PC
; DOWN
        RETLW   $00+$00
        RETLW   $04+$40 ; DEC
        RETLW   $18+$A0 ; INC  CHANGE
        RETLW   $00+$00

        RETLW   $10+$A0 ; INC  CHANGE
        RETLW   $04+$00
        RETLW   $04+$00
        RETLW   $0C+$40 ; DEC

        RETLW   $00+$40 ; DEC
        RETLW   $08+$00
        RETLW   $08+$00
        RETLW   $1C+$A0 ; INC  CHANGE

        RETLW   $0C+$00
        RETLW   $14+$A0 ; INC  CHANGE
        RETLW   $08+$40 ; DEC
        RETLW   $0C+$00
; UP
        RETLW   $10+$00
        RETLW   $04+$60 ; DEC  CHANGE
        RETLW   $18+$80 ; INC
        RETLW   $10+$00

        RETLW   $10+$80 ; INC
        RETLW   $14+$00
        RETLW   $14+$00
        RETLW   $0C+$60 ; DEC  CHANGE

        RETLW   $00+$60 ; DEC  CHANGE
        RETLW   $18+$00
        RETLW   $18+$00
        RETLW   $1C+$80 ; INC

        RETLW   $1C+$00
        RETLW   $14+$80 ; INC
        RETLW   $08+$60 ; DEC  CHANGE
        RETLW   $1C+$00

; ----------   DIGITS LOOKUP TABLE2   ----------

DIGITS  ANDLW   $0F
        ADDWF   PC
        RETLW   $3F             ; 0
        RETLW   $06             ; 1
        RETLW   $5B             ; 2
        RETLW   $4F             ; 3

        RETLW   $66             ; 4
        RETLW   $6D             ; 5
        RETLW   $7D             ; 6
        RETLW   $07             ; 7

        RETLW   $7F             ; 8
        RETLW   $6F             ; 9
        RETLW   $77             ; A
        RETLW   $7C             ; B

        RETLW   $39             ; C
        RETLW   $5E             ; D
        RETLW   $79             ; E
        RETLW   $71             ; F

; ----------   TRANSLATION TABLE3   ----------

TRANS3  ANDLW   $7F
        ADDWF   PC
        RETLW   $00
        RETLW   $01
        RETLW   $02
        RETLW   $03
        RETLW   $04
        RETLW   $05
        RETLW   $06
        RETLW   $07

        RETLW   $08
        RETLW   $09
        RETLW   $10
        RETLW   $11
        RETLW   $12
        RETLW   $13
        RETLW   $14
        RETLW   $15

        RETLW   $16
        RETLW   $17
        RETLW   $18
        RETLW   $19
        RETLW   $20
        RETLW   $21
        RETLW   $22
        RETLW   $23

        RETLW   $24
        RETLW   $25
        RETLW   $26
        RETLW   $27
        RETLW   $28
        RETLW   $29
        RETLW   $30
        RETLW   $31

        RETLW   $32
        RETLW   $33
        RETLW   $34
        RETLW   $35
        RETLW   $36
        RETLW   $37
        RETLW   $38
        RETLW   $39

        RETLW   $40
        RETLW   $41
        RETLW   $42
        RETLW   $43
        RETLW   $44
        RETLW   $45
        RETLW   $46
        RETLW   $47

        RETLW   $48
        RETLW   $49
        RETLW   $50
        RETLW   $51
        RETLW   $52
        RETLW   $53
        RETLW   $54
        RETLW   $55

        RETLW   $56
        RETLW   $57
        RETLW   $58
        RETLW   $59
        RETLW   $60
        RETLW   $61
        RETLW   $62
        RETLW   $63

        RETLW   $64
        RETLW   $65
        RETLW   $66
        RETLW   $67
        RETLW   $68
        RETLW   $69
        RETLW   $70
        RETLW   $71

        RETLW   $72
        RETLW   $73
        RETLW   $74
        RETLW   $75
        RETLW   $76
        RETLW   $77
        RETLW   $78
        RETLW   $79

        RETLW   $80
        RETLW   $81
        RETLW   $82
        RETLW   $83
        RETLW   $84
        RETLW   $85
        RETLW   $86
        RETLW   $87

        RETLW   $88
        RETLW   $89
        RETLW   $90
        RETLW   $91
        RETLW   $92
        RETLW   $93
        RETLW   $94
        RETLW   $95

        RETLW   $FF

; ----------   CODE   ----------

        ORG     $101

        MOVLW   $0F
        TRIS    PORTA

        MOVLW   $0F
        MOVWF   PORTB
        MOVLW   $80
        TRIS    PORTB

        CLRF    LEVEL
        CLRF    STATE1

        GOTO    OUTPUT

MAIN    MOVF    PORTA,W
        ANDLW   $03
        IORWF   STATE1,W
        CALL    NEXT1
        MOVWF   STATE1

INC_L   BTFSS   STATE1,7
        GOTO    DEC_L

        MOVLW   255
        SUBWF   LEVEL,W
        BTFSS   STATUS,C
        INCF    LEVEL           ; LEVEL < 255
        GOTO    OUTPUT          ; LEVEL >= 255

DEC_L   BTFSS   STATE1,6
        GOTO    CHECK

        MOVLW   1
        SUBWF   LEVEL,W
        BTFSC   STATUS,C
        DECF    LEVEL           ; LEVEL >= 1
        GOTO    OUTPUT          ; LEVEL < 1

CHECK   BTFSC   PORTB,TESTB
        GOTO    MAIN

OUTPUT  MOVF    LEVEL,W
        CALL    TXGAIN
        MOVF    LEVEL,W
        CALL    TXGAIN

        BSF     PORTB,LOAD1

DISPLAY
        MOVLW   192
        SUBWF   LEVEL,W
        MOVWF   TEMP
        BTFSS   STATUS,C
        GOTO    MINUS           ; LEVEL < 192
                                ; LEVEL >= 192
PLUS
        MOVLW   $26
        CALL    TXDIS
        GOTO    OPNUM

MINUS   MOVLW   $24
        CALL    TXDIS
        COMF    TEMP
        INCF    TEMP

OPNUM   RRF     TEMP,W
        CALL    TRANS3
        MOVWF   NUM
        SWAPF   NUM,W
        CALL    DIGITS
        CALL    TXDIS
        MOVF    NUM,W
        CALL    DIGITS
        CALL    TXDIS

        MOVLW   0
        BTFSC   TEMP,0
        MOVLW   5
        CALL    DIGITS
        CALL    TXDIS

        BSF     PORTB,LOAD2
        NOP
        BCF     PORTB,LOAD2

        GOTO    MAIN

; ----------   TXB2 SUBROUTINE   ----------

TXB2    MOVWF   TXSR
        BCF     PORTB,LOAD2
        MOVLW   8
        MOVWF   I

SHIFT2  BTFSC   TXSR,7
        BSF     PORTB,DATA2
        BTFSS   TXSR,7
        BCF     PORTB,DATA2

        BSF     PORTB,CLK2
        RLF     TXSR            ; DO SOMETHING
        BCF     PORTB,CLK2

        DECFSZ  I
        GOTO    SHIFT2
        RETLW   0

; ----------   TXB1 SUBROUTINE   ----------

TXB1    MOVWF   TXSR
        BCF     PORTB,LOAD1
        MOVLW   8
        MOVWF   I

SHIFT1  BTFSC   TXSR,7
        BSF     PORTB,DATA1
        BTFSS   TXSR,7
        BCF     PORTB,DATA1

        BCF     PORTB,CLK1
        RLF     TXSR            ; DO SOMETHING
        BSF     PORTB,CLK1

        DECFSZ  I
        GOTO    SHIFT1
        RETLW   0

        ORG     PIC54
RESET   GOTO    $100

