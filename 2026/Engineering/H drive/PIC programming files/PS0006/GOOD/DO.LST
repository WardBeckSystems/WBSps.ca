0109               ; ----------   RAM REGISTERS   ----------
0110               
0111   0008        DBSSW   RES     1       ; DBS  SWITCH DEBOUNCE STATE.
0112   0009        ONSW    RES     1       ; ON   SWITCH DEBOUNCE STATE.
0113   000A        OFFSW   RES     1       ; OFF  SWITCH DEBOUNCE STATE.
0114   000B        AUTOSW  RES     1       ; AUTO SWITCH DEBOUNCE STATE.
0115               
0116   000C        GPI1    RES     1       ; GPI 1  INPUT DEBOUNCE STATE.
0117   000D        GPI2    RES     1       ; GPI 2  INPUT DEBOUNCE STATE.
0118   000E        MODE    RES     1       ; OPERATION MODE OF SOFTWARE.
0119   000F        ONOFF   RES     1       ; TEMP STORAGE FOR ON & OFF TALLY OUTPUTS
0120                                       ; WHILE PORTB IS USED TO READ INPUTS.
0121               
0122   0010        OLD     RES     1       ; LAST VALUE OF RTCC.
0123   0011        TMRON0  RES     1       ; ON  TIMER  LOW BYTE
0124   0012        TMRON1  RES     1       ;            HIGH BYTE
0125   0013        TMROFF0 RES     1       ; OFF TIMER  LOW BYTE
0126   0014        TMROFF1 RES     1       ;            HIGH BYTE
0127   0015        TMRDBS0 RES     1       ; DBS TIMER  LOW BYTE
0128   0016        TMRDBS1 RES     1       ;            FIRST HIGH BYTE
0129   0017        TMRDBS2 RES     1       ;            SECOND HIGH BYTE
0130   0018        TMRHLF0 RES     1       ; 1/2 SECOND LOW BYTE
0131   0019        TMRHLF1 RES     1       ; TIMER      FIRST HIGH BYTE
0132   001A        TMRHLF2 RES     1       ;            SECOND HIGH BYTE
0133               
0134               ; USE 4K5 AND 330pF FOR RC OSCILATOR SO THAT OS2 = 128kHz.
0135               ; WITH OPTION 6 THE PRESCALER DIVIDES OS2 BY 128 SO THAT
0136               ; RTCC IS INCREMENTED EVER 1 msec.
0137               ; DURING EVER CALL TO TESTGPI THE WAIT LOOP WAITS FOR THE RTCC
0138               ; TO CHANGE BY COMPARING IT TO ITS LAST VALUE STORED IN OLD.
0139               ; THEN OLD IS UPDATED TO THE CURRENT VALUE OF RTCC AND THE LOW
0140               ; BYTES OF ALL THE TIMERS ARE DECREMENTED.
0141               
0142               ; ALL THE TIMERS COUNT DOWN.
0143               
0144               ; THE ON & OFF TIMER VALUES IN msec ARE EQUAL TO:
0145               ;     ( LOW BYTE-1 ) + 256 * ( HIGH BYTE )
0146               ; IF BIT 7 OF THE HIGH BYTE IS SET THEN THE TIMER IS STOPPED.
0147               
0148               ; THE DBS TIMER AND 1/2 SECOND TIMER VALUES IN msec ARE EQUAL TO:
0149               ;     ( LOW BYTE ) + 128 * ( HIGH BYTE )
0150               ; IF BIT 7 OF THE LOW BYTE IS SET THEN
16c5x/xx Cross-Assembler V4.14 Released  Wed May 31 15:14:58 1995  Page 3

Line   PC    Opcode

0151               ;     DECREMENT THE HIGH BYTE AND CLEAR BIT 7 OF THE LOW BYTE.
0152               ; IF BIT 7 OF THE HIGH BYTE IS SET THEN THE TIMER IS STOPPED.
0153               
0154               ; TMRON1 & TMRON0 ARE USED TO TIME THE VARIABLE ON DELAY TIME.
0155               ; TMROFF1 & TMROFF0 ARE USED TO TIME THE VARIABLE OFF DELAY TIME.
0156               
0157               ; TMRHLF1 & TMRHLF0 ARE USED TO TIME THE FIRST 1/2 SECOND AFTER
0158               ; ONE OF THE GPI INPUTS IS ACTIVATED.
0159               ; TMRHLF2 & TMRHLF0 ARE USED TO TIME THE SECOND 1/2 SECOND AFTER
0160               ; ONE OF THE GPI INPUTS IS ACTIVATED.
0161               
0162               ; TMRDBS1 & TMRDBS0 ARE USED TO TIME THE VARIABLE DBS DELAY.
0163               ; TMRDBS2 & TMRDBS0 ARE USED TO TIME THE 1.5 SECOND DBS PULSE.
0164               
0165               ; ----------   EQUATES   ----------
0166               
0167         005C  DBS0    EQU     92
0168         000B  DBS1    EQU     11          ; 11*128+92=1500 msec
0169         0074  HALF0   EQU     116
0170         0003  HALF1   EQU     3           ; 3*128+116=500 msec
0171               
0172                                           ; MODE BITS
0173         0003  AUTOBIT EQU     3           ; UNIT IN AUTO MODE.
0174         0004  F1BIT   EQU     4           ; GPI1 STARTED ON TIMER.
0175         0005  F2BIT   EQU     5           ; GPI2 STARTED OFF TIMER.
0176               
0177                                           ; PORTB DATA DIRECTION
0178         0030  PBDD_1  EQU     0x30         ; PORTB READ GPI / OUTPUT ON,OFF
0179         00F0  PBDD_2  EQU     0xF0         ; PORTB READ INPUTS/SWITCHES
0180               
0181                                           ; DECODER ADDRESSES
0182         00C8  PBIP    EQU     (XONOFF+8)  ; INPUTS
0183         00C9  PBSW1   EQU     PBIP+1      ; SWITCH 1
0184         00CA  PBSW2   EQU     PBIP+2      ; SWITCH 2
0185         00CB  PBSW3   EQU     PBIP+3      ; SWITCH 3
0186         000F  PBNONE  EQU     0x0F         ; DISABLE ALL BUFFERS BY SELECTING NONE
0187               
0188         0000          ORG     0x000
0189               
0190               ; ----------   NEXT STATE TABLE1   ----------
0191                                       ; SET BIT 0 OF THE STATE TO INPUT
0192                                       ; BEFORE CALLING NEXT1
0193         0003  KEYBIT  EQU     3       ; BIT TEST KEYBIT AFTER CALLING NEXT1
0194         0004  KPRESS  EQU     4       ; BIT TEST FOR HIGH PULSE
0195         0005  KREL    EQU     5       ; BIT TEST FOR LOW PULSE
0196               
