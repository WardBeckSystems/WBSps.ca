; ----------   PIC16C5X HEADER   ----------

W       EQU     0

; RESET ADDRESSES

PIC54   EQU     $1FF
PIC55   EQU     $1FF
PIC56   EQU     $3FF
PIC57   EQU     $7FF

; STATUS WORD REGISTER f3

C       EQU     0
DC      EQU     1
Z       EQU     2
PD      EQU     3
TO      EQU     4
PA0     EQU     5
PA1     EQU     6
PA2     EQU     7

; OPERATIONAL REGISTER FILES

IND     EQU     00
RTCC    EQU     01
PC      EQU     02
STATUS  EQU     03
FSR     EQU     04
PORTA   EQU     05
PORTB   EQU     06
PORTC   EQU     07

; ----------   END HEADER   ----------

LEVEL   EQU     08
STATE1  EQU     09              ; ENCODER STATE
TXSR    EQU     10              ; TX SHIFT REGISTER
I       EQU     11
TEMP    EQU     12
NUM     EQU     13

; ----------   PORTB BITS   ----------

DATA1   EQU     0
CLK1    EQU     1
LOAD1   EQU     2

DATA2   EQU     4
CLK2    EQU     5
LOAD2   EQU     6

TESTB   EQU     7               ; OUTPUT LEVEL IF BIT LOW

; ----------   JUMP TABLE   ----------

        ORG     $088

TXGAIN  GOTO    TXB1
TXDIS   GOTO    TXB2

; ----------   NEXT STATE TABLE1   ----------

NEXT1   EQU     $001

; ----------   DIGITS LOOKUP TABLE2   ----------

DIGITS  EQU     $013

; ----------   TRANSLATION TABLE3   ----------

TRANS3  EQU     $25

; ----------   CODE   ----------

        ORG     $101

        MOVLW   $0F
        TRIS    PORTA

        MOVLW   $0F
        MOVWF   PORTB
        MOVLW   $80
        TRIS    PORTB

        CLRF    LEVEL
        CLRF    STATE1

        GOTO    OUTPUT

MAIN    MOVF    PORTA,W
        ANDLW   $03
        IORWF   STATE1,W
        CALL    NEXT1
        MOVWF   STATE1

INC_L   BTFSS   STATE1,7
        GOTO    DEC_L

        MOVLW   255
        SUBWF   LEVEL,W
        BTFSS   STATUS,C
        INCF    LEVEL           ; LEVEL < 255
        GOTO    OUTPUT          ; LEVEL >= 255

DEC_L   BTFSS   STATE1,6
        GOTO    CHECK

        MOVLW   1
        SUBWF   LEVEL,W
        BTFSC   STATUS,C
        DECF    LEVEL           ; LEVEL >= 1
        GOTO    OUTPUT          ; LEVEL < 1

CHECK   BTFSC   PORTB,TESTB
        GOTO    MAIN

OUTPUT  MOVF    LEVEL,W
        CALL    TXGAIN
        MOVF    LEVEL,W
        CALL    TXGAIN

        BSF     PORTB,LOAD1

DISPLAY
        MOVLW   192
        SUBWF   LEVEL,W
        MOVWF   TEMP
        BTFSS   STATUS,C
        GOTO    MINUS           ; LEVEL < 192
                                ; LEVEL >= 192
PLUS
        MOVLW   $26
        CALL    TXDIS
        GOTO    OPNUM

MINUS   MOVLW   $24
        CALL    TXDIS
        COMF    TEMP
        INCF    TEMP

OPNUM   RRF     TEMP,W
        CALL    TRANS3
        MOVWF   NUM
        SWAPF   NUM,W
        CALL    DIGITS
        CALL    TXDIS
        MOVF    NUM,W
        CALL    DIGITS
        CALL    TXDIS

        MOVLW   0
        BTFSC   TEMP,0
        MOVLW   5
        CALL    DIGITS
        CALL    TXDIS

        BSF     PORTB,LOAD2
        NOP
        BCF     PORTB,LOAD2

        GOTO    MAIN

; ----------   TXB2 SUBROUTINE   ----------

TXB2    MOVWF   TXSR
        BCF     PORTB,LOAD2
        MOVLW   8
        MOVWF   I

SHIFT2  BTFSC   TXSR,7
        BSF     PORTB,DATA2
        BTFSS   TXSR,7
        BCF     PORTB,DATA2

        BSF     PORTB,CLK2
        RLF     TXSR            ; DO SOMETHING
        BCF     PORTB,CLK2

        DECFSZ  I
        GOTO    SHIFT2
        RETLW   0

; ----------   TXB1 SUBROUTINE   ----------

TXB1    MOVWF   TXSR
        BCF     PORTB,LOAD1
        MOVLW   8
        MOVWF   I

SHIFT1  BTFSC   TXSR,7
        BSF     PORTB,DATA1
        BTFSS   TXSR,7
        BCF     PORTB,DATA1

        BCF     PORTB,CLK1
        RLF     TXSR            ; DO SOMETHING
        BSF     PORTB,CLK1

        DECFSZ  I
        GOTO    SHIFT1
        RETLW   0

        ORG     PIC54
RESET   GOTO    $100
