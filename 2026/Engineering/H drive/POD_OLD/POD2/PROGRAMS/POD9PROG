;Pod 9 Audio Switcher

	list	p=16C73A
	#include "P16C73A.INC"

		org	0
		call 	init
		call	output
		goto	main
	
		org	20h
output_reg	res	1
pre_output	res	1
bcount		res	1
bounce		res	1
comp_reg	res	1
rel_flag	res	1
parity		res	1
parity_check	res	1
recieved_reg	res	1
good_data	res	1
led_dance	res	1
led_count	res	1
shift_count	res	1
transmit_flag	res	1
remote_flag	res	1
timer_end	res	1
spi_transmit	res	1
spi_output	res	1
spi_recieved	res	1
pre_spi		res	1
input_reg	res	1
input_flag	res	1
spi_reg		res	1
output_flag	res	1
audio		res	1
audio_reg	res	1
video		res	1
video_reg	res	1
uart_flag	res	1
transmit_reg	res	1
spi_count	res	1


		ORG 	4H
		RETFIE

video_table	addwf	PCL,1
		nop
		retlw	0xBF
		retlw	0xFE
		retlw	0x7F
		retlw	0xFD
		retlw	0xF7
		retlw	0xFB
		return

;***************************************************
;************   Main Program    ********************
;***************************************************
main		clrwdt
		call	input
		call	debounce
		call	router
		call	output		
		call	debounce_rel
		call	recieve_uart
		call	translate_uart
		call	transmit_uart
		call	SPI_trns_cntrl
		call	SPI_master
		call	SPI_rcv_ctrl
		call	timer_check
		goto	main

;***************************************************
;***********    Initialization	 *******************
;***************************************************
init		BSF	STATUS,5	; set bank 1
		BSF 	ADCON1,PCFG2	;porta is digital i/o
		BSF 	ADCON1,PCFG1
		movlw	0xFF
		movwf	TRISA		; porta is an input.
		movwf	TRISC		; portc is an input. *Must change
		bcf	TRISC,0
		bcf	TRISC,5
		bcf	TRISC,3
		clrf	TRISB		; set portb as an output.
		movlw	0x07
		movwf	SPBRG		; Set the baudrate genetor
		movwf	spi_count
		bcf	TXSTA,SYNC	; Enable asynchonous mode
		bcf	TXSTA,BRGH	; Low mode baud rate
		bsf	TXSTA,TX9
		bsf	TXSTA,TXEN
		BCF	STATUS,5	; set bank 0
		movlw	0xBF
		movwf 	output_reg		;only input1 led is on.
		movwf	pre_output
		movlw	0xFE
		movwf	bcount		; debouncing counter
		bcf	rel_flag,0
		bsf	PORTC,0
		bsf	RCSTA,SPEN	; Enable serial ports RC7 and RC6
		bsf	RCSTA,CREN	; Continuous recieve enabled
		bsf	RCSTA,RX9	; Nine bit recieve enabled
		clrf	TMR2
		movlw	0xFF
		movwf	T2CON
		bcf	PIR1,TMR2IF
		clrf	remote_flag
		clrf	SSPCON
		bsf	SSPCON,SSPEN
		clrf	rel_flag
		clrf	input_flag
		bsf	output_flag,0
		bsf	output_flag,1
		movwf	SSPBUF
		return

;*****************************************************
;**********   Input Subroutine   *********************
;*****************************************************
input		clrf	input_reg
		btfsc	PORTA,3		;check input1
		bsf	input_reg,6	;
		btfsc	PORTA,2		;check input2
		bsf 	input_reg,0	
		btfsc	PORTA,5		;check input3
		bsf	input_reg,7
		btfsc	PORTA,4		;check input4
		bsf	input_reg,1
		btfsc	PORTC,2		;check input5
		bsf	input_reg,3
		btfsc	PORTC,1		;check input6
		bsf	input_reg,2	
		btfsc	PORTA,0		;check spare
		bsf	input_reg,4
		btfsc	PORTA,1		;check mix
		bsf	input_reg,5
		return

;*******************************************************
;************    Debounce Subroutine  ******************
;*******************************************************
debounce	btfsc	rel_flag,0
		return
		movf	input_reg,w	;check to see if the input has
		xorlw	0xFF		;changed
		btfsc	STATUS,Z
		goto	bcount_reset
		movlw	0xFE
		xorwf	bcount,w	
		btfsc	STATUS,2
		call	bounceset
		movf	input_reg,w
		subwf	bounce,w
		btfss	STATUS,2
bcount_reset	call 	reset_bcount
		decfsz	bcount,1
		return
		movlw	0xFE
		movwf	bcount
		bsf	rel_flag,0
		bsf	input_flag,0
		return	
	
;*******************************************************
;**************    Output Subrountine  *****************
;*******************************************************			 
router		btfss	input_flag,0
		goto	next_route0
		btfss	pre_output,5
		call	next_output1
		btfsc	pre_output,5
		call	next_output2
		movf	input_reg,w
		movwf	output_reg
		movwf	pre_output
		bsf	output_flag,0
		return
next_route0	btfss	remote_flag,0
		goto	next_route1
		movf	spi_reg,w
		movwf	output_reg
		movwf	pre_output
		bsf	output_flag,0
		bcf	remote_flag,0
		return
next_route1	btfss	remote_flag,1
		return
		movf	video_reg,w
		movwf	output_reg
		bsf	output_flag,0
		bcf	remote_flag,1
		return
	
;***********************************
output		btfss	output_flag,0
		return
		movf	output_reg,w
		movwf	pre_output
		bcf	output_flag,0
		movlw	0x08
		movwf	shift_count
shift_out	bcf	PORTB,6
		btfsc	output_reg,0
		bsf	PORTB,6
		bsf	PORTB,7
		bcf	PORTB,7
		rrf	output_reg,1
		decfsz	shift_count,1
		goto	shift_out
		bsf	PORTB,5
		bcf	PORTB,5
		movlw	0xFE
		movwf	bcount
		return

;***************************************************
next_output1	btfss	input_reg,5
		goto	if_clear
		bcf	input_reg,5
		return
if_clear	movf	pre_output,w
		movwf	input_reg
		bsf	input_reg,5
		return
;***************************************************
next_output2	btfsc	input_reg,5
		return
		movf	pre_output,w
		movwf	input_reg
		bcf	input_reg,5
		return
;***************************************************
;*********   Debounce Release Subroutine  **********
;***************************************************
debounce_rel	btfss	rel_flag,0
		return
		movf	input_reg,0
		xorlw	0xFF
		btfss	STATUS,2
		call	reset_bcount
		decfsz	bcount,1
		return
		movlw	0xFE
		movwf	bcount
		bcf	rel_flag,0
		return		

bounceset	movf	input_reg,0
		movwf	bounce
		return

reset_bcount	movlw	0xFF
		movwf	bcount
		return
;*************************************
recieve_uart	btfss	PIR1,RCIF
		return	
		btfsc	RCSTA,FERR
		goto	aerror
		btfss	RCSTA,OERR
		goto	do_recieve
aerror		bcf	RCSTA,CREN
		bsf	RCSTA,CREN
do_recieve	clrf	parity
		btfsc	RCSTA,RX9D
		bsf	parity,0
		movf	RCREG,w
		movwf	recieved_reg
		clrf	parity_check
		movlw	0x01
		btfsc	recieved_reg,0		;Parity Check
		xorwf	parity_check,1
		btfsc	recieved_reg,1
		xorwf	parity_check,1	
		btfsc	recieved_reg,2
		xorwf	parity_check,1
		btfsc	recieved_reg,3
		xorwf	parity_check,1	
		btfsc	recieved_reg,4
		xorwf	parity_check,1
		btfsc	recieved_reg,5
		xorwf	parity_check,1	
		btfsc	recieved_reg,6
		xorwf	parity_check,1
		btfsc	recieved_reg,7
		xorwf	parity_check,1
		movlw	0x01
		andwf	parity,1
		andwf	parity_check,1
		movf	parity,0
		subwf	parity_check,0
		btfsc	STATUS,Z
		bsf	transmit_flag,0
		return

;************************************
translate_uart	btfss	transmit_flag,0
		return
		movf	recieved_reg,w
		andlw	0xF0
		xorlw	0xF0		
		btfss	STATUS,Z
		goto	next_check1
		bsf	uart_flag,7
		bcf	transmit_flag,0
		return
next_check1	btfss	uart_flag,7
		return
		bcf	uart_flag,7
		btfss	recieved_reg,7
		goto	next_check2
		btfsc	recieved_reg,6
		return
		movlw	0x38
		andwf	recieved_reg,w
		btfsc	STATUS,Z
		goto	audio_prog
		movwf	video_reg
		bsf	remote_flag,1
		clrf	input_flag
		bcf	remote_flag,0
		bcf	STATUS,C
		rrf	video_reg
		rrf	video_reg
		rrf	video_reg
		movf	video_reg,w
		andlw	0x07
		call	video_table
		movwf	video_reg
audio_prog	movlw	0x07
		andwf	recieved_reg,w
		btfsc	STATUS,Z
		goto	next_check2
		movwf	audio_reg
		movwf	spi_output
		bsf	spi_transmit,0
		bsf	spi_output,7
		bsf	uart_flag,0
next_check2	bcf	recieved_reg,7
		bcf	recieved_reg,6
		movf	recieved_reg,w
		movwf	transmit_reg
		return

;*************************************		
transmit_uart	BSF	STATUS,5	; set bank 1
		btfss	TXSTA,TRMT
		goto	no_transmit
		BCF	STATUS,5
		bcf	PORTC,0			;Set Transmit
		btfss	transmit_flag,0
		goto	no_transmit
		bcf	transmit_flag,0
		bsf	PORTC,0
		clrf	parity
		movlw	0x01
		btfsc	transmit_reg,0		;Parity Check
		xorwf	parity,1
		btfsc	transmit_reg,1
		xorwf	parity,1	
		btfsc	transmit_reg,2
		xorwf	parity,1
		btfsc	transmit_reg,3
		xorwf	parity,1	
		btfsc	transmit_reg,4
		xorwf	parity,1
		btfsc	transmit_reg,5
		xorwf	parity,1	
		btfsc	transmit_reg,6
		xorwf	parity,1
		btfsc	transmit_reg,7
		xorwf	parity,1
		BSF	STATUS,5
		bcf	TXSTA,TX9D
		BCF	STATUS,5
		btfsc	parity,0
		call	set_parity
		movf	transmit_reg,w
		movwf	TXREG
no_transmit	BCF	STATUS,5
		return

timer_check	btfss	PIR1,TMR2IF
		return
		clrf	T2CON
		clrf	TMR2
		bsf	spi_transmit,0
		movlw	0xFF
		movwf	T2CON
		bcf	PIR1,TMR2IF
		return

set_parity	BSF	STATUS,5
		bsf	TXSTA,TX9D
		BCF	STATUS,5
		return


SPI_trns_cntrl	btfsc	uart_flag,0
		return
		btfss	spi_transmit,0
		return
		clrf	spi_output
		btfsc	input_flag,1
		bsf	spi_output,7
		bsf	spi_output,0
		btfss	pre_output,6
		return
		incf	spi_output,1
		btfss	pre_output,0
		return
		incf	spi_output,1
		btfss	pre_output,7
		return
		incf	spi_output,1
		btfss	pre_output,1
		return
		incf	spi_output,1
		btfss	pre_output,3
		return
		incf	spi_output,1
		btfss	pre_output,2
		return
		incf	spi_output,1
		return
		
SPI_master	BSF	STATUS,RP0
		btfss	SSPSTAT,BF
		goto	no_spi
		BCF	STATUS,RP0
		btfss	spi_transmit,0
		return
		movf	SSPBUF,w
		movwf	spi_recieved
		movf	spi_output,w
		movwf	SSPBUF
		decfsz	spi_count,1
		return
		movlw	0x07
		movwf	spi_count
		bcf	input_flag,1
		bcf	uart_flag,0
no_spi		BCF	STATUS,RP0		
		return
	

SPI_rcv_ctrl	btfss	spi_transmit,0
		return
		bcf	spi_transmit,0
		btfss	spi_recieved,7
		return
		btfsc	spi_recieved,6
		return
		bcf	spi_recieved,7
		movlw	0xFF
		movwf	spi_reg
		decfsz	spi_recieved,1
		goto	next_recie0
		bsf	remote_flag,0
		bcf	spi_reg,6
		return
next_recie0	decfsz	spi_recieved,1
		goto	next_recie1
		bsf	remote_flag,0
		bcf	spi_reg,0
		return
next_recie1	decfsz	spi_recieved,1
		goto	next_recie2
		bsf	remote_flag,0
		bcf	spi_reg,7
		return
next_recie2	decfsz	spi_recieved,1
		goto	next_recie3
		bsf	remote_flag,0
		bcf	spi_reg,1
		return
next_recie3	decfsz	spi_recieved,1
		goto	next_recie4
		bsf	remote_flag,0
		bcf	spi_reg,3
		return
next_recie4	decfsz	spi_recieved,1
		goto	next_recie5
		bsf	remote_flag,0
		bcf	spi_reg,2
		return
next_recie5	decfsz	spi_recieved,1
		return
		bcf	spi_reg,2
		movf	spi_reg,w
		movwf	audio
		bsf	remote_flag,0
		return

	
		END

