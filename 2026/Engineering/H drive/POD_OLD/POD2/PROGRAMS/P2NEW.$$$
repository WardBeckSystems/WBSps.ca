;Pod 2 Audio Switcher

	list	p=16C73A
	#include "P16C73A.INC"

		org	0
		call 	init
		goto	main
	
		org	20h
output_reg	res	1
pre_output	res	1
bcount		res	1
bounce		res	1
comp_reg	res	1
rel_flag	res	1
remote_flag	res	1
parity		res	1
recieved_reg	res	1
parity_check	res	1
transmit_flag	res	1
timer_end0	res	1
timer_end1	res	1
spi_recieved	res	1
spi_output	res	1
input_flag	res	1
input_reg	res	1
start_bit	res	1
spi_temp	res	1
input_count	res	1
video		res	1
spi_reg		res	1


		ORG 	4H		
		RETFIE

main		clrwdt
		call	input
		call	debounce
		call	router
		call	debounce_rel
;		call	recieve_uart
;		call 	transmit_uart
		call	SPI_trns_cntrl
		call	SPI_slave
		call	SPI_rcv_ctrl
		goto	main
;**********************************
init		BSF	STATUS,5	; set bank 1
		BSF 	ADCON1,PCFG2	;porta is digital i/o
		BSF 	ADCON1,PCFG1
		movlw	0xFF
		movwf	TRISA		; porta is an input.
		movwf	TRISC		; portc is an input. *Must change
		bcf	TRISC,0
		bcf	TRISC,5
		clrf	TRISB		; set portb as an output.
		movlw	0x07
		movwf	SPBRG		; Set the baudrate genetor
		movwf	timer_end0
		movwf	timer_end1
		bcf	TXSTA,SYNC	; Enable asynchonous mode
		bcf	TXSTA,BRGH	; Low mode baud rate
		bsf	TXSTA,TX9
		bsf	TXSTA,TXEN
		BCF	STATUS,5	; set bank 0
		movlw	0xFE
		movwf 	PORTB		;only input1 led is on.
		movwf	pre_output
		movlw	0xFE
		movwf	bcount		; debouncing counter
		movwf	input_count
		bcf	rel_flag,0
		bsf	PORTC,0
		bsf	RCSTA,SPEN	; Enable serial ports RC7 and RC6
		bsf	RCSTA,CREN	; Continuous recieve enabled
		bsf	RCSTA,RX9	; Nine bit recieve enabled
		clrf	TMR2
		movlw	0xFF
		movwf	T2CON
		bcf	PIR1,TMR2IF
		clrf	remote_flag
		movlw	0x25
		movwf	SSPCON
		clrf	rel_flag
		clrf	input_flag
		clrf	start_bit
		return

;This sub routine will check the inputs and return the corresponding
;inputs in a output_reg ready to be loaded into portb.

input		clrf	input_reg
		btfsc	PORTA,3		;check input1
		bsf	input_reg,0	;
		btfsc	PORTA,2		;check input2
		bsf 	input_reg,1	
		btfsc	PORTA,5		;check input3
		bsf	input_reg,2
		btfsc	PORTA,4		;check input4
		bsf	input_reg,3
		btfsc	PORTC,2		;check input5
		bsf	input_reg,4
		btfsc	PORTC,1		;check input6
		bsf	input_reg,5	
		btfsc	PORTA,0		;check spare
		bsf	input_reg,7
		btfsc	PORTA,1		;check mix
		bsf	input_reg,6
		return
;**********************************
debounce	btfsc	rel_flag,0
		return
		movf	input_reg,w	;check to see if the input has
		xorlw	0xFF		;changed
		btfsc	STATUS,Z
		goto	bcount_reset
		movlw	0xFE
		xorwf	bcount,0	
		btfsc	STATUS,2
		call	bounceset
		movf	input_reg,0
		subwf	bounce,0
		btfss	STATUS,2
bcount_reset	call 	reset_bcount
		decfsz	bcount,1
		return
		movlw	0xFE
		movwf	bcount
		bsf	rel_flag,0
		bsf	input_flag,0
		bsf	input_flag,1
		bsf	input_flag,2
		return	

;**********************************	
router		btfss	input_flag,1
		goto	next_route0
		btfss	input_flag,0
		return
		movf	input_reg,0
		btfss	pre_output,6
		goto	mix
		btfsc	input_reg,6
		goto	no_mix
mix		xorwf	pre_output,0
		movwf	comp_reg
		comf	comp_reg,0
no_mix		movwf	pre_output
		movwf	PORTB
		movwf	output_reg
		bcf	input_flag,0
		return
next_route0	btfss	remote_flag,0
		goto	next_route1
		movf	spi_reg,w
		movwf	PORTB
		movwf	output_reg
		bcf	remote_flag,0
		return
next_route1	btfss	remote_flag,3
		return
		btfss	remote_flag,4
		return	
		movf	recieved_reg,w
		movwf	PORTB
		bcf	remote_flag,4
		return

;**********************************
debounce_rel	btfss	rel_flag,0
		return
		movf	input_reg,0
		xorlw	0xFF
		btfss	STATUS,2
		call	reset_bcount
		decfsz	bcount,1
		return
		movlw	0xFE
		movwf	bcount
		bcf	rel_flag,0
		return		

;**********************************
bounceset	movf	input_reg,0
		movwf	bounce
		return

;**********************************
reset_bcount	movlw	0xFF
		movwf	bcount
		return


;**********************************
recieve_uart	btfss	PIR1,RCIF
		return	
		btfsc	RCSTA,FERR
		goto	aerror
		btfss	RCSTA,OERR
		goto	do_recieve
aerror		bcf	RCSTA,CREN
		bsf	RCSTA,CREN
do_recieve	clrf	parity
		btfsc	RCSTA,RX9D
		bsf	parity,0
		movf	RCREG,0
		movwf	recieved_reg
		clrf	parity_check
		movlw	0x01
		btfsc	recieved_reg,0		;Parity Check
		xorwf	parity_check,1
		btfsc	recieved_reg,1
		xorwf	parity_check,1	
		btfsc	recieved_reg,2
		xorwf	parity_check,1
		btfsc	recieved_reg,3
		xorwf	parity_check,1	
		btfsc	recieved_reg,4
		xorwf	parity_check,1
		btfsc	recieved_reg,5
		xorwf	parity_check,1	
		btfsc	recieved_reg,6
		xorwf	parity_check,1
		btfsc	recieved_reg,7
		xorwf	parity_check,1
		movlw	0x01
		andwf	parity,1
		andwf	parity_check,1
		movf	parity,0
		subwf	parity_check,0
		btfss	STATUS,Z
		return
		movf	recieved_reg,w
		btfsc	STATUS,Z
		bsf	remote_flag,2
		bsf	remote_flag,3
		bsf	transmit_flag,0
		return

;**********************************	
transmit_uart	btfss	transmit_flag,0
		return
		BSF	STATUS,5	; set bank 1
		btfss	TXSTA,TRMT
		goto	no_transmit
		BCF	STATUS,5
		bcf	PORTC,0			;Set Transmit
		btfss	transmit_flag,0
		goto	no_transmit
		bcf	transmit_flag,0
		bsf	PORTC,0
		clrf	parity
		movlw	0x01
		btfsc	recieved_reg,0		;Parity Check
		xorwf	parity,1
		btfsc	recieved_reg,1
		xorwf	parity,1	
		btfsc	recieved_reg,2
		xorwf	parity,1
		btfsc	recieved_reg,3
		xorwf	parity,1	
		btfsc	recieved_reg,4
		xorwf	parity,1
		btfsc	recieved_reg,5
		xorwf	parity,1	
		btfsc	recieved_reg,6
		xorwf	parity,1
		btfsc	recieved_reg,7
		xorwf	parity,1
		BSF	STATUS,5
		bcf	TXSTA,TX9D
		BCF	STATUS,5
		btfsc	parity,0
		call	set_parity
		movf	recieved_reg,w
		movwf	TXREG
		bcf	transmit_flag,2
		movlw	0x07
		movwf	timer_end1
no_transmit	BCF	STATUS,5
		return



;**********************************
set_parity	BSF	STATUS,5
		bsf	TXSTA,TX9D
		BCF	STATUS,5
		return
;**********************************
SPI_trns_cntrl	clrf	spi_output
		btfsc	input_flag,1
		bsf	spi_output,7
		bsf	spi_output,0
		btfss	pre_output,0
		return
		incf	spi_output
		btfss	pre_output,1
		return
		incf	spi_output
		btfss	pre_output,2
		return
		incf	spi_output
		btfss	pre_output,3
		return
		incf	spi_output
		btfss	pre_output,4
		return
		incf	spi_output
		btfss	pre_output,5
		return
		incf	spi_output
		return		

;**********************************	
SPI_slave	BSF	STATUS,RP0
		btfss	SSPSTAT,BF
		goto	no_spi
		BCF	STATUS,RP0
		movf	SSPBUF,w
		movwf	spi_recieved
		movwf	spi_temp
re_write	movf	spi_output,0
		movwf	SSPBUF
		btfss	SSPCON,WCOL
		goto	spi_cont
		bcf	SSPCON,WCOL
		goto	re_write	
spi_cont	bsf	remote_flag,0
		return
no_spi		BCF	STATUS,RP0
		return

	
SPI_rcv_ctrl	btfss	input_flag,2
		goto	normal_SPI_rec
		bcf	input_flag,2
		clrf	spi_recieved
		return
normal_SPI_rec	btfss	spi_recieved,7
		return
		btfsc	spi_recieved,6
		return
		bcf	input_flag,1
		bcf	spi_recieved,7
		movlw	0xFF
		movwf	spi_reg
		decfsz	spi_recieved,1
		goto	next_recie0
		bsf	remote_flag,0
		bcf	spi_reg,0
		return
next_recie0	decfsz	spi_recieved,1
		goto	next_recie1
		bsf	remote_flag,0
		bcf	spi_reg,1
		return
next_recie1	decfsz	spi_recieved,1
		goto	next_recie2
		bsf	remote_flag,0
		bcf	spi_reg,2
		return
next_recie2	decfsz	spi_recieved,1
		goto	next_recie3
		bsf	remote_flag,0
		bcf	spi_reg,3
		return
next_recie3	decfsz	spi_recieved,1
		goto	next_recie4
		bsf	remote_flag,0
		bcf	spi_reg,4
		return
next_recie4	decfsz	spi_recieved,1
		goto	next_recie5
		bsf	remote_flag,0
		bcf	spi_reg,5
		return
next_recie5	decfsz	spi_recieved,1
		return
		bcf	spi_reg,2
		movf	spi_reg,w
		movwf	video
		bsf	remote_flag,0
		return

		END

