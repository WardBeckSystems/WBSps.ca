;Pod 2 Audio Switcher

	list	p=16C73A
	#include "P16C73A.INC"

		org	0
		call 	init
		goto	main
	
		org	20h
output_reg	res	1
pre_output	res	1
last_change	res	1
which_change	res	1
bcount		res	1
bounce		res	1


main		call	input
		movfw	output_reg	;check to see if the input has 
		subwf	pre_output,0	;changed
		btfsc	STATUS,2
		goto	main
		call	debounce
		call	last_change
		call	output
		goto	main

init		movlw	0xFE
		movwf 	PORTA		;only input1 led is on.
		clrf 	PORTA
		clrf	PORTC
		BSF	STATUS,5
		movlw	0xFF
		movwf	TRISA		; porta is an input.
		movwf	TRISC		; portc is an input. *Must change
		movlw	0x0
		movwf	TRISB		; portb is an output.
		return

;This sub routine will check the inputs and return the corresponding
;inputs in a output_reg ready to be loaded into portb.

input		clrf	output_reg	;clear the memory location of the output.
		movfw	PORTA		;load input from porta 
		btfsc	PORTA,3		;check input1
		bsf	output_reg,0	;
		btfsc	PORTA,2		;check input2
		bsf 	output_reg,1	
		btfsc	PORTA,5		;check input3
		bsf	output_reg,2
		btfsc	PORTA,4		;check input4
		bsf	output_reg,3
		btfsc	PORTC,2		;check input5
		bsf	output_reg,4
		btfsc	PORTC,1		;check input6
		bsf	output_reg,5	
		btfsc	PORTA,0		;check spare
		bsf	output_reg,6
		btfsc	PORTA,1		;check mix
		bsf	output_reg,7
		return

debounce	movfw	bcount
		sublw	0xFF	
		btfss	STATUS,2
		call	bounceset
		movfw	output_reg
		subwf	bounce,0
		btfss	STATUS,2
		call 	reset_bcount
		return
				
	

changecheck	movfw	output_reg
		xorwf	pre_output,0
		movwf	which_change
		btfss	which_change,0		;check if input1 changed
		goto	change_2
		movlw	0x01
		movwf	last_change
		goto	no_input_change
change_2	movfw	output_reg
		xorwf	pre_output,0
		movwf	which_change
		btfss	which_change,1		;check if input2 changed
		goto	change_3
		movlw	0x02
		movwf	last_change
change_3	movfw	output_reg
		xorwf	pre_output,0
		movwf	which_change
		btfss	which_change,2		;check if input3 changed
		goto	change_4
		movlw	0x03
		movwf	last_change
change_4	movfw	output_reg
		xorwf	pre_output,0
		movwf	which_change
		btfss	which_change,3		;check if input4 changed
		goto	change_5
		movlw	0x04
		movwf	last_change
change_5	movfw	output_reg		
		xorwf	pre_output,0
		movwf	which_change
		btfss	which_change,4		;check if input5 changed
		goto	change_6
		movlw	0x05
		movwf	last_change
change_6	movfw	output_reg
		xorwf	pre_output,0
		movwf	which_change
		btfss	which_change,5		;check if input6 changed
		goto	no_input_change
		movlw	0x06
		movwf	last_change
no_input_change	return

output		decfsz	bcount,1		;Check the debounce counter
		goto	no_output		;output
		movfw	output_reg		;Check if there is a mix
		andlw	0x80
		btfss	STATUS,2		;if there is a mix then	
		call	no_mix			;
		bcf	output_reg,last_change
		movfw	output_reg
		movwf	pre_output
		movwf	PORTB
		movlw	0xFF
		movwf	bcount
no_output	return

bounceset	movfw	output_reg
		movwf	bounce
		return

reset_bcount	movlw	0xFF
		movwf	bcount
		return

no_mix		movlw	0xFF
		movwf	output_reg
		return

		END

