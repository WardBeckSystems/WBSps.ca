/PCBdict 62 dict def
PCBdict begin
/f true def
/h false def
/a1 0 def /a2 0 def /a3 0 def /a4 0 def /a5 0 def
/a6 0 def /a7 0 def /a8 0 def /a9 0 def /a0 0 def
/s0 () def
/EX {/exec load} bind def
/fp {4 {pop} repeat} bind def
/m {.072 mul} bind def
/min {2 copy gt {exch} if pop} bind def
/dp {m exch m exch translate 5 m setlinewidth newpath} bind def
/pt { %def
	/a5 exch m def /a4 exch m def /a3 exch m def
	/a2 exch m def /a1 exch m def
	gsave
		1 setlinecap a5 setlinewidth
		newpath
		a3 a4 moveto a1 a2 lineto stroke
		f not a5 10 m gt and
			{
			newpath
			a5 10 m sub setlinewidth
			a1 a2 moveto a3 a4 lineto
			gsave 1 setgray stroke grestore
			newpath
			5 m setlinewidth
			a1 a2 a5 2 div 0 360 arc closepath stroke
			newpath a3 a4 a5 2 div 0 360 arc closepath stroke
			} if
	grestore
	} bind def
/pa { %def
	/a6 exch def /a1 exch def /a5 exch m def
	/a4 exch m def /a3 exch m def /a2 exch m def
	/a7 a1 cos a5 mul a2 add def
	/a8 a1 sin a5 mul a3 add def
	/a9 a1 a6 add cos a5 mul a2 add def
	/s0 a1 a6 add sin a5 mul a3 add def
	gsave
		1 setlinecap a4 setlinewidth
		newpath
		a2 a3 a5 a1 a1 a6 add arc stroke
		f not a4 10 m gt and
			{
			newpath
			a4 10 m sub setlinewidth
			a2 a3 a5 a1 a1 a6 add arc
			gsave 1 setgray stroke grestore
			newpath
			5 m setlinewidth
			a7 a8 a4 2 div 0 360 arc closepath stroke
			newpath a9 s0 a4 2 div 0 360 arc closepath stroke
			} if
	grestore
	} bind def
/ps { %def
	/s0 exch def /a1 exch def /a2 exch m def
	gsave
		/Helvetica findfont a2 1.36 mul scalefont setfont
		m exch m exch translate
		a1 dup 4 lt
			{90 mul rotate} {4 sub 90 mul rotate -1 1 scale} ifelse
		newpath
		0 0 moveto s0 f {show} {true charpath 5 m setlinewidth stroke} ifelse
	grestore
	} bind def
/rr { %def
	/a4 exch 2 div def /a2 exch m 2 div def /a1 exch m 2 div def
	/a3 0.5 a1 a2 min mul def
	gsave
		m exch m exch translate
		newpath
		a1 neg 0 moveto
		a1 neg a2 0 a2 a3 arcto fp
		a1 a2 a1 0 a3 arcto fp
		a1 a2 neg 0 a2 neg a3 arcto fp
		a1 neg a2 neg a1 neg 0 a3 arcto fp
		closepath
		f {fill} {5 m a1 a2 min div setlinewidth stroke newpath} ifelse
		h a4 0 ne and {0 0 a4 m 0 360 arc} if
		f {gsave 1 setgray fill grestore} {5 m setlinewidth stroke} ifelse
	grestore
	} bind def
/sr { %def
	/a3 exch 2 div def /a2 exch def /a1 exch def
	gsave
		m exch m exch translate
		gsave
			newpath
			0 setgray
			a1 m a2 m scale
			-.5 -.5 moveto -.5 .5 lineto .5 .5 lineto .5 -.5 lineto
			closepath
			f {fill} {10 m a1 a2 min div setlinewidth stroke newpath} ifelse
		grestore
		h a3 0 ne and {0 0 a3 m 0 360 arc} if
		f {gsave 1 setgray fill grestore} {5 m setlinewidth stroke} ifelse
	grestore
	} bind def
/el { %def
	/a3 exch 2 div def /a2 exch 2 div def /a1 exch 2 div def
	gsave
		m exch m exch translate
		gsave
			newpath
			a1 m a2 m scale
			0 0 1 0 360 arc closepath
			f {fill} {10 m a1 a2 min div setlinewidth stroke newpath} ifelse
		grestore
		f {1 setgray} if
		h a3 0 ne and {0 0 a3 m 0 360 arc} if
		f {gsave 1 setgray fill grestore} {5 m setlinewidth stroke} ifelse
	grestore
	} bind def
/ov { %def
	/a4 exch 2 div def /a2 exch m 2 div def /a1 exch m 2 div def
	/a3 1.0 a1 a2 min mul def
	gsave
		m exch m exch translate
		newpath
		a1 neg +0 moveto
		a1 neg a2 0 a2 a3 arcto fp
		a1 a2 a1 0 a3 arcto fp
		a1 a2 neg 0 a2 neg a3 arcto fp
		a1 neg a2 neg a1 neg 0 a3 arcto fp
		closepath
		f {fill} {5 m setlinewidth stroke newpath} ifelse
		h a4 0 ne and {0 0 a4 m 0 360 arc} if
		f {gsave 1 setgray fill grestore} {stroke} ifelse
	grestore
	} bind def
/mh { %def
	pop pop /a1 exch m 2 div def
	gsave
		m exch m exch translate
		newpath
		a1 neg 0 moveto a1 0 lineto 0 a1 neg moveto 0 a1 lineto
		8 m a1 div setlinewidth stroke
		newpath
		0 0 a1 0 360 arc
		15 m setlinewidth stroke
	grestore
	} bind def
/tg { %def
	pop pop /a1 exch m 2 div def /a3 a1 5 div def /a2 a3 def
	gsave
		m exch m exch translate
		8 m a1 div setlinewidth
		newpath
		a1 neg 0 moveto a1 0 lineto 0 a1 neg moveto 0 a1 lineto stroke
		newpath
		4  {0 0 a2 0 360 arc /a2 a2 a3 add def} repeat
		stroke
	grestore
	} bind def
/pps { %def
	gsave
		newpath
		m exch m exch moveto
	} bind def
/ppp { %def
	m exch m exch lineto
	} bind def
/ppe { %def
		m exch m exch lineto
		closepath eofill
	grestore
	} bind def
%%EndProlog
