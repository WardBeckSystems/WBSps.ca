;**************  SCAN  PUSH BUTTON ROUTINE ***********************

; 
SCAN	
;SET DIRECTION FOR INPUTS ON SHARED I/O
	BANK1
	BSF TRISA,2	;SHARED WITH 4094 DATA & 165 STROBE
	BSF TRISB,4	;SHARED WITH 4094/165 CLOCK
	BANK0
	MOVLW 0XFF
	MOVWF PORTB	;ALL SEL LINES HIGH
	MOVLW B'11000000'
	ANDWF SEL0,F	;CLEAR SEL REGISTERS EXCEPT FOR FLAGS
	CLRF SEL1
	CLRF SEL2
	CLRF SEL3
	CLRF SEL4
;SEL0
	BCF PORTB,7	;SEL0 LOW

	BTFSS PORTB,5	;TEST FOR CLOSURE
	BSF SEL0,0
	BTFSS PORTA,2
	BSF SEL0,1
	BTFSS PORTb,4
	BSF SEL0,2
	BTFSS PORTb,6
	BSF SEL0,3
	BTFSS PORTa,1
	BSF SEL0,4
	BTFSS PORTa,0
	BSF SEL0,5
	BSF PORTB,7	;SEL0 HIGH
;SEL1
	BCF PORTB,3	;SEL1 LOW
	BTFSS PORTB,5	;TEST FOR CLOSURE
	BSF SEL1,0
	BTFSS PORTA,2
	BSF SEL1,1
	BTFSS PORTb,4
	BSF SEL1,2
	BTFSS PORTb,6
	BSF SEL1,3
	BTFSS PORTA,1
	BSF SEL1,4
	BTFSS PORTA,0
	BSF SEL1,5
	BSF PORTB,3
;SEL2
	BCF PORTB,0	;SEL2 LOW
	BTFSS PORTB,5	;TEST FOR CLOSURE
	BSF SEL2,0
	BTFSS PORTA,2
	BSF SEL2,1
	BTFSS PORTB,4
	BSF SEL2,2
	BTFSS PORTB,6
	BSF SEL2,3
	BTFSS PORTA,1
	BSF SEL2,4
	BTFSS PORTA,0
	BSF SEL2,5
	BSF PORTB,0

;SEL3
	BCF PORTB,2	;SEL3 LOW
	BTFSS PORTB,5	;TEST FOR CLOSURE
	BSF SEL3,0
	BTFSS PORTA,2
	BSF SEL3,1
	BTFSS PORTB,4
	BSF SEL3,2
	BTFSS PORTB,6
	BSF SEL3,3
	BTFSS PORTA,1
	BSF SEL3,4
	BTFSS PORTA,0
	BSF SEL3,5
	BSF PORTB,2
;SEL4
	BCF PORTB,1	;SEL4 LOW
	BTFSS PORTB,5	;TEST FOR CLOSURE
	BSF SEL4,0
	BTFSS PORTA,2
	BSF SEL4,1
	BTFSS PORTB,4
	BSF SEL4,2
	BTFSS PORTB,6
	BSF SEL4,3
	BTFSS PORTA,1
	BSF SEL4,4
	BTFSS PORTA,0
	BSF SEL4,5
	BSF PORTB,1

;WAS THERE A CLOSURE

	MOVF SEL0,W
	ANDLW B'00111111'
	BTFSS STATUS,Z
	GOTO NOTZERO
	MOVF SEL1,W
	BTFSS STATUS,Z
	GOTO NOTZERO
	MOVF SEL2,W
	BTFSS STATUS,Z
	GOTO NOTZERO
	MOVF SEL3,W
	BTFSS STATUS,Z
	GOTO NOTZERO
	MOVF SEL4,W
	BTFSS STATUS,Z
	GOTO NOTZERO

;MUST BE ZERO
	
	DECFSZ BOUNCE,F
	RETURN
	CLRF SEL0
	MOVLW BINIT
	MOVWF BOUNCE
	RETURN

NOTZERO		;CLOSURE DETECTED

;COMPARE SCAN/BOUNCE

	BTFSS SEL0,6
	GOTO	COMP	;WAIT FOR PB RELEASE
	MOVLW BINIT
	MOVWF BOUNCE
	RETURN


COMP	MOVF SEL0,W
	ANDLW B'00111111'
	XORWF BOUNCE0,W
	BTFSS STATUS,Z
	GOTO NOTEQUAL
	
	MOVF SEL1,W
	XORWF BOUNCE1,W
	BTFSS STATUS,Z
	GOTO NOTEQUAL

	MOVF SEL2,W
	XORWF BOUNCE2,W
	BTFSS STATUS,Z
	GOTO NOTEQUAL

	MOVF SEL3,W
	XORWF BOUNCE3,W
	BTFSS STATUS,Z
	GOTO NOTEQUAL

	MOVF SEL4,W
	XORWF BOUNCE4,W
	BTFSS STATUS,Z
	GOTO NOTEQUAL

;MUST BE EQUAL
	DECFSZ BOUNCE,F
	RETURN
	BSF SEL0,7
	MOVLW BINIT
	MOVWF BOUNCE	;RESET DEBOUNCE COUNT
	RETURN
NOTEQUAL

	MOVF SEL0,W
	MOVWF BOUNCE0

	MOVF SEL1,W
	MOVWF BOUNCE1
	MOVF SEL2,W
	MOVWF BOUNCE2
	MOVF SEL3,W
	MOVWF BOUNCE3
	MOVF SEL4,W
	MOVWF BOUNCE4
	MOVLW 20
	MOVWF BOUNCE
	RETURN

	
