;-------------------------------------
stlin	
;TURN OFF L AND R MODE AND TURN ON STEREO MODE
	BSF SHOUT7,2	;TURN OFF LEFT TALLY
	BSF SHOUT7,7	;TURN OFF RIGHT TALLY
	BCF SHOUT7,6	;TURN ON STEREO TALLY

	
	BSF SHOUT6,3	;L-R OFF
	BcF SHOUT7,4	;R-R on
	BcF SHOUT7,1	;L-L on
	BSF SHOUT7,0	;R-L OFF
	BsF SHOUT7,5	;MONO off
	return
;-------------------------------------
lpad

		
	BSF SHOUT7,6	;TURN OFF STEREO TALLY
	BTFSS SHOUT7,2	;IS LEFT ON NOW ?
	GOTO LON	;YES IT IS ON
	BCF SHOUT7,2	;MUST BE OFF TURN IT ON
	BTFSC SHOUT7,7	;IS R ON
	GOTO ROFFL

	BSF SHOUT6,3	;L-R OFF
	BSF SHOUT7,4	;R-R OFF
	BSF SHOUT7,1	;L-L OFF
	BSF SHOUT7,0	;R-L OFF
	BcF SHOUT7,5	;MONO ON
	RETURN
ROFFL	
	BCF SHOUT6,3	;L-R ON
	BSF SHOUT7,4	;R-R OFF
	BCF SHOUT7,1	;L-L ON
	BSF SHOUT7,0	;R-L OFF
	BsF SHOUT7,5	;MONO OFF
	RETURN 

LON	BTFSC SHOUT7,7	;IS RIGHT TALLY ON
	RETURN		;MUST BE OFF SO RETURN
	BSF SHOUT7,2	;TURN IT OFF
	
	BSF SHOUT6,3	;L-R OFF
	BCF SHOUT7,4	;R-R ON
	BSF SHOUT7,1	;L-L OFF
	BCF SHOUT7,0	;R-L ON
	BsF SHOUT7,5	;MONO OFF
	RETURN

;--------------------------------------
rmic
	
	BSF SHOUT7,6	;TURN OFF STEREO TALLY
	BTFSS SHOUT7,7	;IS RIGHT ON NOW ?
	GOTO RON	;YES IT IS ON
	BCF SHOUT7,7	;MUST BE OFF TURN IT ON
	BTFSC SHOUT7,7	;IS R ON
	GOTO LOFFR

	BSF SHOUT6,3	;L-R OFF
	BSF SHOUT7,4	;R-R OFF
	BSF SHOUT7,1	;L-L OFF
	BSF SHOUT7,0	;R-L OFF
	BcF SHOUT7,5	;MONO ON
