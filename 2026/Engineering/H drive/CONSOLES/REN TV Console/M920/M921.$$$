;*******************  REFRESH ***********************************

;     REFRESH  - TRANSMITS CROSSPOINT TABLE TO 74HC4094'S


CLK	EQU 4	; PORTB BIT 4
STR	EQU 0	; PORTC BIT 0
DATAA	EQU 2	;PORTA BIT 2
;TEMP1  TEMP FILE REGISTER	
;TEMP2	BIT COUNT

REFRESH
	BANK1
	BCF TRISA,2	;DATAA PIN IS OUTPUT
	BCF TRISC,0	;STROBE PIN IS OUTPUT
 	BCF TRISB,4	;CLOCK PIN IS OUTPUT
	BANK0
	BCF PORTB,CLK


;output shout table
	MOVF SHOUT0,W

	;BTFSS M926-0,X		;IS CHANNEL ON
	;AND W WITH XPT0 ;

	CALL CLKBYTE
	MOVF SHOUT1,W
	CALL CLKBYTE
	MOVF SHOUT2,W
	CALL CLKBYTE
	MOVF SHOUT3,W
	CALL CLKBYTE
	MOVF SHOUT4,W
	CALL CLKBYTE
	MOVF SHOUT5,W
	CALL CLKBYTE
	MOVF SHOUT6,W
	CALL CLKBYTE
	MOVF SHOUT7,W
	CALL CLKBYTE
	MOVF SHOUT8,W
	CALL CLKBYTE
	MOVF SHOUT9,W
	CALL CLKBYTE

	BCF PORTC,STR
	NOP
	BSF PORTC,STR
	BCF PORTC,STR
	BANK1
	BSF TRISA,2	;DATAA PIN IS INPUT
	BANK0

	RETURN

; CLOCK BYTE IN W REGISTER TO 74HC4094'S

CLKBYTE	
	MOVWF TEMP1
	MOVLW 8
	MOVWF TEMP2	;BIT COUNT

NXTBIT	RRF TEMP1,F
	BTFSC STATUS,0
	GOTO ONE
	BCF PORTA,DATAA
	BSF PORTB,CLK
	BCF PORTB,CLK
	DECFSZ TEMP2,F
	GOTO NXTBIT
	RETURN

ONE 	BSF PORTA,DATAA
	BSF PORTB,CLK
	BCF PORTB,CLK
	DECFSZ TEMP2,F
	GOTO NXTBIT
	RETURN

		
;****************  DELAY ROUTINE *****************************


; INIT DELAY 2 BEFORE ENTERING
; DELAY=:: DELAY1(255*1/1.25MHZ*2 * DELAY2)

DELAY
	MOVLW 0XFF
DEL1	MOVWF DELAY1
DEC1	DECFSZ DELAY1,F
	GOTO DEC1
	DECFSZ DELAY2,F
	GOTO DEL1
	RETURN

