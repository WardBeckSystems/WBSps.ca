	BSF SHOUT7,1	;L-L OFF
	BCF SHOUT7,0	;R-L ON
	BsF SHOUT7,5	;MONO OFF
	RETURN 


RON	BTFSC SHOUT7,2	;IS LEFT TALLY ON
	RETURN		;MUST BE OFF SO RETURN

	BSF SHOUT7,7	;TURN IT OFF
	BCF SHOUT6,3	;L-R ON
	BSF SHOUT7,4	;R-R OFF
	BCF SHOUT7,1	;L-L ON
	BSF SHOUT7,0	;R-L OFF
